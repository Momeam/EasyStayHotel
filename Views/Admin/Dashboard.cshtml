@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "ภาพรวมระบบ (Dashboard)";
}

<div class="mt-4">
    <h3 class="fw-bold mb-4">📊 ภาพรวมระบบ (Admin Dashboard)</h3>

    <div class="row">
        <!-- การ์ดจำนวนผู้ใช้งาน -->
        <div class="col-md-3 mb-4">
            <div class="card text-white bg-primary shadow-sm border-0 h-100">
                <div class="card-body d-flex flex-column justify-content-center align-items-center">
                    <h5 class="card-title">👥 ผู้ใช้งานระบบ</h5>
                    <h1 class="display-4 fw-bold">@ViewBag.TotalUsers</h1>
                    <span class="small text-light">บัญชีทั้งหมด</span>
                </div>
            </div>
        </div>

        <!-- การ์ดจำนวนการจองทั้งหมด -->
        <div class="col-md-3 mb-4">
            <div class="card text-white bg-info shadow-sm border-0 h-100">
                <div class="card-body d-flex flex-column justify-content-center align-items-center">
                    <h5 class="card-title">📝 การจองทั้งหมด</h5>
                    <h1 class="display-4 fw-bold">@ViewBag.TotalBookings</h1>
                    <span class="small text-light">รายการ</span>
                </div>
            </div>
        </div>

        <!-- การ์ดจำนวนห้องพักทั้งหมด -->
        <div class="col-md-3 mb-4">
            <div class="card text-dark bg-warning shadow-sm border-0 h-100">
                <div class="card-body d-flex flex-column justify-content-center align-items-center">
                    <h5 class="card-title">🏨 ห้องพักทั้งหมด</h5>
                    <h1 class="display-4 fw-bold">@ViewBag.TotalRooms</h1>
                    <span class="small text-dark">ห้อง</span>
                </div>
            </div>
        </div>

        <!-- การ์ดจำนวนห้องว่าง -->
        <div class="col-md-3 mb-4">
            <div class="card text-white bg-success shadow-sm border-0 h-100">
                <div class="card-body d-flex flex-column justify-content-center align-items-center">
                    <h5 class="card-title">✅ ห้องว่างพร้อมขาย</h5>
                    <h1 class="display-4 fw-bold">@ViewBag.AvailableRooms</h1>
                    <span class="small text-light">ห้อง</span>
                </div>
            </div>
        </div>
    </div>
</div>
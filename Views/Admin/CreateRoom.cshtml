@model EasyStayHotel.Models.Room
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "เพิ่มห้องพักใหม่";
    var roomTypes = ViewBag.RoomTypes as List<EasyStayHotel.Models.Roomtype> ?? new List<EasyStayHotel.Models.Roomtype>();
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-dark text-white p-3">
                <h5 class="m-0 fw-bold"><i class="bi bi-door-open-fill text-warning me-2"></i>เพิ่มห้องพักใหม่เข้าสู่ระบบ</h5>
            </div>
            <div class="card-body p-4">
                <form asp-controller="Admin" asp-action="CreateRoom" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="RoomNo" class="form-label fw-bold">หมายเลขห้อง (Room Number): <span class="text-danger">*</span></label>
                            <input asp-for="RoomNo" class="form-control form-control-lg" placeholder="เช่น 101, 201, 305" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Branch" class="form-label fw-bold">สาขาของโรงแรม (Branch): <span class="text-danger">*</span></label>
                            <select asp-for="Branch" class="form-select form-select-lg" required>
                                <option value="Bangkok">สาขากรุงเทพมหานคร (Bangkok)</option>
                                <option value="Chonburi">สาขาชลบุรี-พัทยา (Chonburi)</option>
                                <option value="Phuket">สาขาภูเก็ต (Phuket)</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RoomTypeId" class="form-label fw-bold">ประเภทห้องพัก (Room Type): <span class="text-danger">*</span></label>
                        <select asp-for="RoomTypeId" class="form-select form-select-lg border-primary" required>
                            <option value="">-- กรุณาเลือกประเภทห้องพัก --</option>
                            @foreach (var rt in roomTypes)
                            {
                                <option value="@rt.RoomTypeId">@rt.TypeName (฿@rt.BasePrice.ToString("N0") / คืน - ความจุ @rt.Capacity ท่าน)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Status" class="form-label fw-bold">สถานะห้องพักเริ่มต้น:</label>
                        <select asp-for="Status" class="form-select" required>
                            <option value="Available">ว่างพร้อมขาย (Available)</option>
                            <option value="Cleaning">กำลังทำความสะอาด (Cleaning)</option>
                            <option value="Maintenance">ปิดปรับปรุง / ซ่อมบำรุง (Maintenance)</option>
                        </select>
                    </div>

                    <hr />
                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-controller="Admin" asp-action="RoomManagement" class="btn btn-outline-secondary rounded-pill px-4">กลับหน้ารายการห้องพัก</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> บันทึกข้อมูลห้องพัก
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
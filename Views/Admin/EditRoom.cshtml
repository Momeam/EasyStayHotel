@model EasyStayHotel.Models.Room
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "แก้ไขห้องพัก";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-warning">
                <h5 class="m-0">✏️ แก้ไขข้อมูลห้องพัก (หมายเลข @Model.RoomNo)</h5>
            </div>
            <div class="card-body p-4">
                <form asp-controller="Admin" asp-action="EditRoom" method="post">
                    <!-- ซ่อน RoomId เพื่อใช้อ้างอิงตอนบันทึกทับ -->
                    <input type="hidden" asp-for="RoomId" />
                    
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="RoomNo" class="form-label fw-bold">หมายเลขห้อง (Room Number):</label>
                        <input asp-for="RoomNo" class="form-control" required />
                        <span asp-validation-for="RoomNo" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RoomTypeId" class="form-label fw-bold">ประเภทห้องพัก (Room Type ID):</label>
                        <input asp-for="RoomTypeId" type="number" class="form-control" required />
                    </div>

                    <div class="mb-4">
                        <label asp-for="Status" class="form-label fw-bold">สถานะห้องพัก:</label>
                        <select asp-for="Status" class="form-select" required>
                            <option value="Available">ว่าง (Available)</option>
                            <option value="Occupied">มีผู้เข้าพัก (Occupied)</option>
                            <option value="Cleaning">กำลังทำความสะอาด (Cleaning)</option>
                            <option value="Maintenance">ปิดปรับปรุง (Maintenance)</option>
                        </select>
                    </div>

                    <hr />
                    <div class="d-flex justify-content-between">
                        <a asp-controller="Admin" asp-action="RoomManagement" class="btn btn-outline-secondary">ยกเลิกกลับไปหน้าหลัก</a>
                        <button type="submit" class="btn btn-warning px-5 fw-bold">💾 บันทึกการแก้ไข</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
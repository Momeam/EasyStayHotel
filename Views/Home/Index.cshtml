@section Scripts {
    <script>
        $(document).ready(function () {
            // 1. ตรวจสอบวันที่ Check-in / Check-out ให้สอดคล้องกันเสมอ
            $('#mainCheckIn').on('change', function () {
                const checkInVal = $(this).val();
                if (checkInVal) {
                    const nextDay = new Date(checkInVal);
                    nextDay.setDate(nextDay.getDate() + 1);
                    const minCheckOut = nextDay.toISOString().split('T')[0];

                    $('#mainCheckOut').attr('min', minCheckOut);
                    if ($('#mainCheckOut').val() <= checkInVal) {
                        $('#mainCheckOut').val(minCheckOut);
                    }
                }
            });

            // 2. ระบบสลับแท็บสาขาในส่วนพรีวิวห้องพัก (Branch Filter Tabs)
            $('.branch-filter-btn').on('click', function () {
                $('.branch-filter-btn').removeClass('active');
                $(this).addClass('active');

                const selectedBranch = $(this).data('branch');
                const checkIn = $('#mainCheckIn').val();
                const checkOut = $('#mainCheckOut').val();

                // ถ้าเลือกสาขาเฉพาะ ให้เปลี่ยน Dropdown ในฟอร์มค้นหาด้านบนให้ตรงกันด้วย
                if (selectedBranch !== 'ALL') {
                    $('#searchBranchSelect').val(selectedBranch);
                }

                $('.room-preview-item').each(function () {
                    const card = $(this);
                    const roomTypeId = card.data('roomtype-id');
                    const defaultGuests = card.data('default-guests');
                    let availCount = 0;
                    let targetBranch = card.data('preferred-branch');

                    if (selectedBranch === 'ALL') {
                        availCount = parseInt(card.data('avail-all')) || 0;
                    } else if (selectedBranch === 'Bangkok') {
                        availCount = parseInt(card.data('avail-bangkok')) || 0;
                        targetBranch = 'Bangkok';
                    } else if (selectedBranch === 'Chonburi') {
                        availCount = parseInt(card.data('avail-chonburi')) || 0;
                        targetBranch = 'Chonburi';
                    } else if (selectedBranch === 'Phuket') {
                        availCount = parseInt(card.data('avail-phuket')) || 0;
                        targetBranch = 'Phuket';
                    }

                    // อัปเดตป้ายสถานะจำนวนห้องว่างบนการ์ด
                    const badge = card.find('.avail-status-badge');
                    const countText = card.find('.avail-count-text');

                    if (availCount > 0) {
                        badge.removeClass('bg-secondary').addClass('bg-success');
                        countText.text(selectedBranch === 'ALL' ? `ว่างรวม ${availCount} ห้อง` : `ว่าง ${availCount} ห้อง`);
                    } else {
                        badge.removeClass('bg-success').addClass('bg-secondary');
                        countText.text('เต็มในสาขานี้');
                    }

                    // อัปเดตลิงก์ปุ่ม "จองเลย" ให้ส่งสาขาและวันที่ปัจจุบันไปทันที
                    const bookUrl = `/Booking/Search?branch=${encodeURIComponent(targetBranch)}&checkIn=${encodeURIComponent(checkIn)}&checkOut=${encodeURIComponent(checkOut)}&rooms=1&guests=${defaultGuests}&roomTypeId=${roomTypeId}`;
                    card.find('.quick-book-btn').attr('href', bookUrl);
                });
            });

            // 3. ปุ่มคัดลอกโค้ดส่วนลด
            $('.copy-promo-btn').on('click', function () {
                const btn = $(this);
                const code = btn.data('code');
                navigator.clipboard.writeText(code);

                const originalHtml = btn.html();
                btn.html(`<i class="bi bi-check-circle-fill me-1"></i> คัดลอก ${code} แล้ว!`);
                setTimeout(() => {
                    btn.html(originalHtml);
                }, 2000);
            });
        });
    </script>
}
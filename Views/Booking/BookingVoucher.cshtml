@model EasyStayHotel.Models.Booking
@using EasyStayHotel.Services
@{
    ViewData["Title"] = "เอกสารยืนยันการจองห้องพัก (Booking Voucher) - " + Model.BookingRef;
    var payment = ViewBag.LatestPayment as EasyStayHotel.Models.Payment;
    string branchTh = RoomPreviewHelper.GetBranchNameTh(Model.Room?.Branch);
    string roomTypeName = Model.Room?.RoomType?.TypeName ?? "Standard Room";
    int nights = Model.CheckOutDate.DayNumber - Model.CheckInDate.DayNumber;
    if (nights <= 0) nights = 1;
    DateTime bookingDate = RefundService.GetBookingDate(Model);
    bool isCheckedIn = Model.BookingStatus == "CheckIn" || Model.BookingStatus == "CheckedIn" || Model.BookingStatus == "Completed";
}

<div class="container py-4">
    <!-- แถบเครื่องมือด้านบน (ซ่อนเวลาพิมพ์) -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-3 p-md-4 mb-4 no-print">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill px-3 py-1 mb-1">
                    <i class="bi bi-shield-check me-1"></i> เอกสารการจองฉบับสมบูรณ์
                </span>
                <h4 class="fw-bold m-0 text-dark">เอกสารยืนยันการจองห้องพัก (Booking Confirmation Voucher)</h4>
                <small class="text-muted">รหัสอ้างอิง: <strong class="font-monospace text-primary">@Model.BookingRef</strong></small>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Booking" asp-action="MyBookings" asp-route-bookingRef="@Model.BookingRef" class="btn btn-outline-secondary fw-bold rounded-pill px-3">
                    <i class="bi bi-arrow-left me-1"></i> ตรวจสอบสถานะการจอง
                </a>
                <button type="button" onclick="window.print()" class="btn btn-primary fw-bold rounded-pill px-4 shadow-sm">
                    <i class="bi bi-printer-fill me-1"></i> พิมพ์เอกสาร / บันทึกเป็น PDF
                </button>
            </div>
        </div>
    </div>

    <!-- พื้นที่เอกสารจำลองกระดาษ A4 -->
    <div class="voucher-paper bg-white mx-auto p-4 p-md-5 shadow-sm border rounded-4" style="max-width: 840px;">
        <!-- หัวเอกสาร -->
        <div class="row align-items-center mb-4 pb-3 border-bottom">
            <div class="col-8">
                <div class="d-flex align-items-center">
                    <div class="bg-primary text-white rounded-3 d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 58px; height: 58px;">
                        <i class="bi bi-buildings fs-2"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold m-0 text-dark">Easy Stay Hotel & Resort</h4>
                        <div class="text-muted small">สาขา @branchTh • บริการห้องพักมาตรฐานระดับพรีเมียม</div>
                        <div class="text-muted" style="font-size: 0.78rem;">โทร: 02-123-4567 | อีเมล: support@easystay.com | www.easystay.com</div>
                    </div>
                </div>
            </div>
            <div class="col-4 text-end">
                <span class="badge bg-dark text-white text-uppercase px-3 py-2 rounded-pill small fw-bold">
                    Official Voucher
                </span>
                <div class="small text-muted mt-1">วันที่ออกเอกสาร: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
        </div>

        <!-- กล่องรหัสการจองเด่นชัด (สำหรับยื่นให้พนักงานตอนเช็คอิน) -->
        <div class="p-3 mb-4 rounded-3 text-center border border-2 border-primary border-opacity-50" style="background-color: #f8fbff;">
            <div class="text-uppercase fw-bold text-muted small letter-spacing-1">
                หมายเลขการจองสำหรับแสดงต่อพนักงาน (Booking Reference)
            </div>
            <div class="display-6 fw-bold font-monospace text-primary my-1">
                @Model.BookingRef
            </div>
            <div class="small text-dark fw-medium">
                <i class="bi bi-qr-code-scan me-1 text-primary"></i> กรุณาแสดงรหัสนี้ หรือพิมพ์เอกสารฉบับนี้ยื่นต่อพนักงานต้อนรับ ณ วันที่เข้าพัก
            </div>
        </div>

        <!-- ข้อมูลผู้เข้าพัก และ ข้อมูลการจอง -->
        <div class="row g-4 mb-4">
            <div class="col-sm-6">
                <div class="p-3 bg-light rounded-3 h-100 border">
                    <h6 class="fw-bold text-primary mb-2">
                        <i class="bi bi-person-circle me-1"></i> ข้อมูลผู้เข้าพัก (Guest Information)
                    </h6>
                    <div class="mb-1">
                        <span class="text-muted small">ชื่อ-นามสกุล:</span>
                        <strong class="text-dark d-block">@(Model.GuestName ?? Model.User?.FullName ?? "-")</strong>
                    </div>
                    <div class="mb-1">
                        <span class="text-muted small">เบอร์โทรศัพท์ติดต่อ:</span>
                        <span class="text-dark d-block">@(Model.User?.Phone ?? "-")</span>
                    </div>
                    <div>
                        <span class="text-muted small">อีเมล:</span>
                        <span class="text-dark d-block">@(Model.User?.Email ?? "-")</span>
                    </div>
                </div>
            </div>

            <div class="col-sm-6">
                <div class="p-3 bg-light rounded-3 h-100 border">
                    <h6 class="fw-bold text-primary mb-2">
                        <i class="bi bi-calendar2-check me-1"></i> ข้อมูลการเข้าพัก (Stay Schedule)
                    </h6>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted small">วันที่เช็คอิน (Check-in):</span>
                        <strong class="text-dark">@Model.CheckInDate.ToString("dd MMM yyyy") (14:00 น.)</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted small">วันที่เช็คเอาท์ (Check-out):</span>
                        <strong class="text-dark">@Model.CheckOutDate.ToString("dd MMM yyyy") (12:00 น.)</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted small">ระยะเวลาเข้าพัก:</span>
                        <span class="badge bg-primary text-white rounded-pill px-2">@nights คืน</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted small">วันที่ทำรายการจอง:</span>
                        <span class="text-muted small">@bookingDate.ToString("dd/MM/yyyy HH:mm น.")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- รายละเอียดห้องพักที่จอง -->
        <div class="card border rounded-3 mb-4 overflow-hidden">
            <div class="card-header bg-light py-2 px-3 fw-bold small text-dark d-flex justify-content-between align-items-center">
                <span><i class="bi bi-door-open-fill text-primary me-1"></i> รายละเอียดห้องพัก (Room Details)</span>
                <span class="badge bg-white text-primary border">สาขา @branchTh</span>
            </div>
            <div class="card-body p-3">
                <div class="row align-items-center">
                    <div class="col-sm-8">
                        <h5 class="fw-bold text-dark mb-1">@roomTypeName</h5>
                        <div class="text-muted small mb-2">
                            ความจุ: ผู้เข้าพัก 2 ท่าน • ฟรีอาหารเช้าและสิ่งอำนวยความสะดวกตามมาตรฐานโรงแรม
                        </div>
                        <div>
                            <span class="text-muted small">หมายเลขห้องพัก:</span>
                            @if (isCheckedIn && Model.Room != null)
                            {
                                <span class="badge bg-success fs-6 rounded-pill px-3 py-1 ms-1">
                                    <i class="bi bi-door-closed-fill me-1"></i> ห้อง @Model.Room.RoomNo
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary bg-opacity-10 text-secondary border rounded-pill px-3 py-1 ms-1">
                                    <i class="bi bi-clock-history me-1"></i> พนักงานต้อนรับจะจัดสรรห้องให้ ณ วันเช็คอิน
                                </span>
                            }
                        </div>
                    </div>
                    <div class="col-sm-4 text-sm-end mt-3 mt-sm-0 border-top border-sm-top-0 pt-2 pt-sm-0">
                        <div class="text-muted small">ยอดรวมค่าห้องพัก (@nights คืน)</div>
                        <h4 class="fw-bold text-primary m-0">฿@Model.TotalPrice.ToString("N2")</h4>
                    </div>
                </div>
            </div>
        </div>

        <!-- ข้อมูลการชำระเงิน -->
        <div class="row g-3 mb-4">
            <div class="col-sm-6">
                <div class="p-3 rounded-3 border bg-light h-100">
                    <span class="text-muted small d-block mb-1">สถานะการชำระเงิน (Payment Status):</span>
                    @if (payment != null && (payment.PaymentStatus == "Paid" || payment.PaymentStatus == "Approved"))
                    {
                        <div class="text-success fw-bold fs-6 mb-1">
                            <i class="bi bi-check-circle-fill me-1"></i> ชำระเงินเรียบร้อยแล้ว (Paid)
                        </div>
                        <div class="small text-muted">
                            ช่องทาง: <strong>@(payment.PaymentMethod ?? "PromptPay")</strong>
                            @(payment.TransferDate != null ? $" • วันที่ทำรายการ: {payment.TransferDate.Value.ToString("dd/MM/yyyy HH:mm")}" : "")
                        </div>
                    }
                    else
                    {
                        <div class="text-warning-emphasis fw-bold fs-6 mb-1">
                            <i class="bi bi-hourglass-split me-1"></i> รอยืนยันการตรวจสอบการชำระเงิน
                        </div>
                        <div class="small text-muted">
                            ช่องทาง: @(payment?.PaymentMethod ?? "PromptPay")
                        </div>
                    }
                </div>
            </div>

            <div class="col-sm-6">
                <div class="p-3 rounded-3 border bg-light h-100 text-sm-end">
                    <span class="text-muted small d-block mb-1">ยอดชำระสุทธิ (Total Amount):</span>
                    <h3 class="fw-bold text-success mb-1">฿@Model.TotalPrice.ToString("N2")</h3>
                    <div class="small text-muted">ราคารวมภาษีมูลค่าเพิ่มและค่าบริการแล้ว</div>
                </div>
            </div>
        </div>

        <!-- เงื่อนไขและข้อแนะนำในการเข้าพัก -->
        <div class="p-3 rounded-3 border mb-4 bg-light small">
            <div class="fw-bold text-dark mb-1">
                <i class="bi bi-info-circle-fill text-primary me-1"></i> ข้อกำหนดและคำแนะนำสำหรับการเข้าพัก (Check-in Terms):
            </div>
            <ul class="mb-0 ps-3 text-muted" style="font-size: 0.8rem;">
                <li><strong>การเช็คอิน:</strong> สามารถเช็คอินได้ตั้งแต่เวลา <strong>14:00 น.</strong> เป็นต้นไป และเช็คเอาท์ภายในเวลา <strong>12:00 น.</strong></li>
                <li><strong>หลักฐานการเข้าพัก:</strong> กรุณาแสดงเอกสารยืนยันฉบับนี้พร้อม <strong>บัตรประชาชน หรือ พาสปอร์ตฉบับจริง</strong> ของผู้เข้าพัก ณ เคาน์เตอร์ต้อนรับ</li>
                <li><strong>การจัดห้องพัก:</strong> หมายเลขห้องพักจะถูกจัดสรรจากห้องที่พร้อมให้บริการตามประเภทห้องที่ท่านจองไว้ ณ วันที่ท่านเดินทางมาถึง</li>
                <li><strong>การยกเลิก / ขอคืนเงิน:</strong> สามารถยื่นเรื่องขอคืนเงินได้ภายใน 7 วันหลังจากการจองผ่านหน้าเว็บไซต์</li>
            </ul>
        </div>

        <!-- ส่วนลงนามเพื่อเป็นหลักฐานการเข้าพัก (สำหรับพิมพ์) -->
        <div class="row text-center mt-5 pt-3">
            <div class="col-6">
                <div class="border-bottom border-dark mx-auto mb-2" style="max-width: 220px; height: 35px;"></div>
                <div class="small text-muted fw-bold">ลายมือชื่อผู้เข้าพัก (Guest Signature)</div>
                <div class="text-muted" style="font-size: 0.72rem;">วันที่: _____ / _____ / _________</div>
            </div>
            <div class="col-6">
                <div class="border-bottom border-dark mx-auto mb-2" style="max-width: 220px; height: 35px;"></div>
                <div class="small text-muted fw-bold">ลายมือชื่อพนักงานต้อนรับ (Staff Signature)</div>
                <div class="text-muted" style="font-size: 0.72rem;">วันที่: _____ / _____ / _________</div>
            </div>
        </div>
    </div>
</div>

<style>
    .voucher-paper {
        font-family: 'Kanit', sans-serif;
    }

    @@media print {
        body {
            background-color: white !important;
        }

        .no-print, header, footer, .navbar {
            display: none !important;
        }

        .container {
            width: 100% !important;
            max-width: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        .voucher-paper {
            box-shadow: none !important;
            border: none !important;
            padding: 0 !important;
            max-width: 100% !important;
        }

        @@page {
            margin: 1.2cm;
            size: A4 portrait;
        }
    }
</style>

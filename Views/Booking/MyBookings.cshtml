@model IEnumerable<EasyStayHotel.Models.Booking>
@using EasyStayHotel.Services
@{
    ViewData["Title"] = "ตรวจสอบสถานะการจอง & ประวัติการจอง";
    bool isLoggedIn = ViewBag.IsLoggedIn != null && (bool)ViewBag.IsLoggedIn;
    string searchRef = ViewBag.SearchBookingRef as string ?? "";
    string searchContact = ViewBag.SearchContact as string ?? "";
    bool hasSearched = !string.IsNullOrWhiteSpace(searchRef) || !string.IsNullOrWhiteSpace(searchContact);
}

@functions {
    public (string Label, string BadgeClass, string Icon) GetBookingStatusInfo(string? status)
    {
        return status switch
        {
            "Pending" => ("รอพนักงานตรวจสอบ", "bg-warning text-dark", "bi-hourglass-split"),
            "Confirmed" => ("ยืนยันการจองแล้ว", "bg-info text-dark", "bi-check-circle-fill"),
            "RefundRequested" => ("ยื่นขอคืนเงิน (รอตรวจสอบ)", "bg-warning text-dark", "bi-hourglass-split"),
            "Refunded" => ("คืนเงินเรียบร้อยแล้ว", "bg-success text-white", "bi-check-circle-fill"),
            "CheckIn" or "CheckedIn" => ("เช็คอินเข้าพักแล้ว", "bg-success text-white", "bi-door-open-fill"),
            "Completed" => ("เข้าพักเสร็จสมบูรณ์", "bg-secondary text-white", "bi-award-fill"),
            "Cancelled" => ("ยกเลิกการจอง", "bg-danger text-white", "bi-x-circle-fill"),
            _ => (status ?? "รอดำเนินการ", "bg-primary text-white", "bi-info-circle-fill")
        };
    }

    public (string Label, string BadgeClass) GetPaymentStatusInfo(string? status)
    {
        return status switch
        {
            "Paid" or "Approved" => ("ชำระเงินเรียบร้อย", "bg-success bg-opacity-10 text-success border border-success"),
            "Refunded" => ("คืนเงินแล้ว", "bg-secondary bg-opacity-10 text-muted border border-secondary"),
            "Pending" => ("รอตรวจสอบสลิปโอนเงิน", "bg-warning bg-opacity-10 text-warning border border-warning"),
            "Rejected" => ("หลักฐานไม่ถูกต้อง", "bg-danger bg-opacity-10 text-danger border border-danger"),
            _ => (status ?? "รอตรวจสอบ", "bg-secondary bg-opacity-10 text-secondary border")
        };
    }
}

<div class="container py-5">
    <!-- แจ้งเตือนข้อความสถานะ -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="row justify-content-center mb-3">
            <div class="col-lg-10">
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4 p-3 mb-0" role="alert">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill fs-4 text-success"></i>
                        <div>
                            <strong class="d-block">ดำเนินการสำเร็จ</strong>
                            <span class="small">@TempData["SuccessMessage"]</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="row justify-content-center mb-3">
            <div class="col-lg-10">
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-4 p-3 mb-0" role="alert">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill fs-4 text-danger"></i>
                        <div>
                            <strong class="d-block">เกิดข้อผิดพลาด</strong>
                            <span class="small">@TempData["ErrorMessage"]</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        </div>
    }

    <!-- ส่วนหัวและกล่องค้นหาการจอง -->
    <div class="row justify-content-center mb-4">
        <div class="col-lg-10">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
                <div>
                    <span class="text-primary fw-bold small text-uppercase">Booking Status & History</span>
                    <h3 class="fw-bold mb-1">ตรวจสอบสถานะการจองห้องพัก</h3>
                    <p class="text-muted small mb-0">
                        @(isLoggedIn
                            ? "แสดงรายการจองทั้งหมดของบัญชีคุณ หรือค้นหาด้วยหมายเลขการจอง (Booking Reference)"
                            : "กรอกหมายเลขการจอง (เช่น ES-...) หรืออีเมล/เบอร์โทรศัพท์ที่ใช้จอง เพื่อดูรายละเอียดและสถานะล่าสุด")
                    </p>
                </div>
                <div class="mt-3 mt-md-0">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                        <i class="bi bi-plus-circle me-1"></i> จองห้องพักเพิ่ม
                    </a>
                </div>
            </div>

            <!-- ฟอร์มค้นหาการจอง -->
            <div class="card border-0 shadow-sm rounded-4 bg-white mb-4">
                <div class="card-body p-4">
                    <form asp-controller="Booking" asp-action="MyBookings" method="get" class="row g-3 align-items-end">
                        <div class="col-md-5">
                            <label class="form-label fw-bold small text-muted">
                                <i class="bi bi-hash text-primary"></i> หมายเลขการจอง (Booking Reference)
                            </label>
                            <input type="text" name="bookingRef" class="form-control"
                                   placeholder="เช่น ES-20261116..." value="@searchRef" />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label fw-bold small text-muted">
                                <i class="bi bi-person-lines-fill text-primary"></i> ชื่อผู้จอง / อีเมล / เบอร์โทรศัพท์
                            </label>
                            <input type="text" name="contact" class="form-control"
                                   placeholder="เช่น email@example.com หรือ 08X-XXX-XXXX" value="@searchContact" />
                        </div>
                        <div class="col-md-2 d-flex gap-2">
                            <button type="submit" class="btn btn-primary w-100 fw-bold">
                                <i class="bi bi-search me-1"></i> ค้นหา
                            </button>
                            @if (hasSearched)
                            {
                                <a asp-controller="Booking" asp-action="MyBookings" class="btn btn-outline-secondary" title="ล้างการค้นหา">
                                    <i class="bi bi-x-lg"></i>
                                </a>
                            }
                        </div>
                    </form>
                </div>
            </div>

            <!-- รายการการจอง -->
            @if (Model != null && Model.Any())
            {
                var refundRequests = ViewBag.RefundRequests as Dictionary<int, EasyStayHotel.Models.RefundRequest> ?? new Dictionary<int, EasyStayHotel.Models.RefundRequest>();

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-dark m-0">พบรายการจองทั้งหมด @Model.Count() รายการ</h6>
                </div>

                foreach (var booking in Model)
                {
                    var roomType = booking.Room?.RoomType;
                    string typeName = roomType?.TypeName ?? "ห้องพักมาตรฐาน (Easy Stay Room)";
                    int rtId = roomType?.RoomTypeId ?? 1;
                    string mainImg = RoomPreviewHelper.GetMainImage(typeName, rtId);
                    string branchTh = RoomPreviewHelper.GetBranchNameTh(booking.Room?.Branch);
                    var bookingStatus = GetBookingStatusInfo(booking.BookingStatus);
                    var latestPayment = booking.Payments?.OrderByDescending(p => p.PaymentId).FirstOrDefault();
                    var paymentStatus = GetPaymentStatusInfo(latestPayment?.PaymentStatus);

                    refundRequests.TryGetValue(booking.BookingId, out var refundReq);
                    DateTime bookingDate = RefundService.GetBookingDate(booking);
                    bool isEligible = RefundService.IsEligibleForRefund(booking, out string refundReason, out int daysRemaining);

                    int nights = booking.CheckOutDate.DayNumber - booking.CheckInDate.DayNumber;
                    if (nights < 1) nights = 1;

                    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden bg-white">
                        <div class="card-header bg-light border-bottom py-3 px-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted small">หมายเลขการจอง:</span>
                                <span class="fw-bold text-primary fs-6">@booking.BookingRef</span>
                                <span class="badge bg-white text-dark border ms-2">
                                    <i class="bi bi-geo-alt-fill text-primary me-1"></i>สาขา @(branchTh)
                                </span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge @paymentStatus.BadgeClass rounded-pill px-3 py-1">
                                    <i class="bi bi-credit-card me-1"></i> @paymentStatus.Label
                                </span>
                                <span class="badge @bookingStatus.BadgeClass rounded-pill px-3 py-2">
                                    <i class="bi @bookingStatus.Icon me-1"></i> @bookingStatus.Label
                                </span>
                            </div>
                        </div>

                        <div class="card-body p-4">
                            <div class="row g-4 align-items-center">
                                <!-- รูปภาพพรีวิวห้องพัก -->
                                <div class="col-md-3">
                                    <img src="@mainImg" class="img-fluid rounded-3 w-100 shadow-sm" style="height: 150px; object-fit: cover;" alt="@typeName" />
                                </div>

                                <!-- ข้อมูลการเข้าพัก -->
                                <div class="col-md-6">
                                    <h5 class="fw-bold text-dark mb-1">
                                        @typeName
                                        @if (booking.Room != null && (booking.BookingStatus == "CheckIn" || booking.BookingStatus == "CheckedIn" || booking.BookingStatus == "Completed"))
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success fs-6 fw-normal ms-1">
                                                <i class="bi bi-door-open-fill me-1"></i>ห้อง @booking.Room.RoomNo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary fs-6 fw-normal ms-1" title="พนักงานต้อนรับจะเลือกห้องว่างที่พร้อมเข้าพักให้ตอนเช็คอิน">
                                                <i class="bi bi-clock-history me-1"></i>จัดสรรห้องตอนเช็คอิน
                                            </span>
                                        }
                                    </h5>
                                    <p class="text-muted small mb-3">
                                        <i class="bi bi-person-fill me-1"></i> ผู้เข้าพัก: <strong>@(booking.GuestName ?? booking.User?.FullName ?? "-")</strong>
                                    </p>

                                    <div class="row g-2 bg-light rounded-3 p-3 text-center">
                                        <div class="col-4 border-end">
                                            <div class="text-muted" style="font-size: 0.75rem;">เช็คอิน</div>
                                            <div class="fw-bold small text-dark">@booking.CheckInDate.ToString("dd MMM yyyy")</div>
                                        </div>
                                        <div class="col-4 border-end">
                                            <div class="text-muted" style="font-size: 0.75rem;">เช็คเอาท์</div>
                                            <div class="fw-bold small text-dark">@booking.CheckOutDate.ToString("dd MMM yyyy")</div>
                                        </div>
                                        <div class="col-4">
                                            <div class="text-muted" style="font-size: 0.75rem;">ระยะเวลา</div>
                                            <div class="fw-bold small text-primary">@nights คืน</div>
                                        </div>
                                    </div>
                                </div>

                                <!-- ยอดชำระ, ปุ่มดูสลิป และปุ่มขอคืนเงิน -->
                                <div class="col-md-3 text-md-end border-top border-md-top-0 pt-3 pt-md-0">
                                    <div class="text-muted small">ยอดชำระสุทธิ</div>
                                    <h3 class="fw-bold text-success mb-1">฿@booking.TotalPrice.ToString("N0")</h3>
                                    <div class="small text-muted mb-2">
                                        ช่องทาง: @(latestPayment?.PaymentMethod ?? "PromptPay")
                                    </div>

                                    <!-- ปุ่มดู/พิมพ์เอกสารยืนยันการจอง (Booking Voucher) สำหรับนำไปแสดงตอนเช็คอิน -->
                                    <a asp-controller="Booking" asp-action="BookingVoucher" asp-route-bookingRef="@booking.BookingRef" target="_blank"
                                       class="btn btn-primary btn-sm rounded-pill px-3 w-100 mb-2 fw-medium shadow-sm">
                                        <i class="bi bi-file-earmark-text-fill me-1"></i> เอกสารการจอง (Voucher)
                                    </a>

                                    @if (!string.IsNullOrEmpty(latestPayment?.SlipImageUrl))
                                    {
                                        <button type="button"
                                                class="btn btn-outline-primary btn-sm rounded-pill px-3 w-100 mb-2"
                                                data-bs-toggle="modal"
                                                data-bs-target="#slipModal-@booking.BookingId">
                                            <i class="bi bi-receipt me-1"></i> ดูหลักฐานสลิปโอนเงิน
                                        </button>

                                        <!-- Modal แสดงรูปสลิป -->
                                        <div class="modal fade" id="slipModal-@booking.BookingId" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content border-0 rounded-4 overflow-hidden">
                                                    <div class="modal-header bg-dark text-white">
                                                        <h6 class="modal-title fw-bold">หลักฐานการโอนเงิน - @booking.BookingRef</h6>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body text-center p-4 bg-light">
                                                        <img src="@latestPayment.SlipImageUrl" class="img-fluid rounded-3 shadow-sm" style="max-height: 450px;" alt="Payment Slip" />
                                                        <div class="mt-3 small text-muted">
                                                            วันที่ทำรายการ: @(latestPayment.TransferDate?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    <!-- ส่วนแสดงปุ่มและสถานะการขอคืนเงิน -->
                                    @if (refundReq != null)
                                    {
                                        if (refundReq.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark rounded-pill px-3 py-2 w-100 d-block mt-2 mb-1">
                                                <i class="bi bi-hourglass-split me-1"></i> รอฝ่ายบัญชีตรวจสอบ
                                            </span>
                                            <small class="text-danger d-block text-center" style="font-size: 0.72rem;">
                                                <i class="bi bi-clock me-1"></i> คืนเงินภายใน 3 วันทำการ
                                            </small>
                                        }
                                        else if (refundReq.Status == "Approved")
                                        {
                                            <span class="badge bg-success rounded-pill px-3 py-2 w-100 d-block mt-2 mb-1">
                                                <i class="bi bi-check-circle-fill me-1"></i> โอนเงินคืนสำเร็จ
                                            </span>
                                            <small class="text-success d-block text-center" style="font-size: 0.72rem;">
                                                ผ่านบัญชีธนาคารแล้ว
                                            </small>
                                        }
                                        else if (refundReq.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger rounded-pill px-3 py-2 w-100 d-block mt-2 mb-1">
                                                <i class="bi bi-x-circle-fill me-1"></i> ปฏิเสธการคืนเงิน
                                            </span>
                                        }
                                    }
                                    else if (isEligible)
                                    {
                                        <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 w-100 mt-2 fw-medium shadow-sm"
                                                data-bs-toggle="modal" data-bs-target="#refundModal-@booking.BookingId">
                                            <i class="bi bi-arrow-counterclockwise me-1"></i> ขอคืนเงิน (เหลือ @daysRemaining วัน)
                                        </button>
                                    }
                                    else if (booking.BookingStatus != "Cancelled" && booking.BookingStatus != "Refunded" && booking.BookingStatus != "CheckIn" && booking.BookingStatus != "CheckedIn" && booking.BookingStatus != "Completed")
                                    {
                                        <div class="mt-2 text-center text-muted small" style="font-size: 0.72rem;">
                                            <i class="bi bi-info-circle me-1"></i>เกิน 7 วันหลังจอง (หมดเขตขอคืนเงิน)
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- กล่องรายละเอียดสถานะคำขอคืนเงิน (ถ้ามีคำขอ) -->
                            @if (refundReq != null)
                            {
                                @if (refundReq.Status == "Pending")
                                {
                                    <div class="alert alert-warning border-0 rounded-4 p-3 mt-3 mb-0 small">
                                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                            <div>
                                                <span class="badge bg-warning text-dark rounded-pill px-3 py-1 fw-bold mb-1">
                                                    <i class="bi bi-hourglass-split me-1"></i> คำขอคืนเงินส่งถึงฝ่ายบัญชีแล้ว (รอดำเนินการ)
                                                </span>
                                                <div class="text-dark fw-medium mt-1">
                                                    <i class="bi bi-bank me-1 text-primary"></i> บัญชีรับเงินคืน: <strong>@refundReq.BankName</strong> เลขที่ <strong>@refundReq.BankAccountNumber</strong> (@refundReq.BankAccountName)
                                                </div>
                                                <div class="text-danger fw-medium mt-1" style="font-size: 0.8rem;">
                                                    <i class="bi bi-clock-history me-1"></i> กำหนดโอนเงินคืนเข้าบัญชีภายใน 3 วันทำการ (ภายในวันที่ <strong>@refundReq.RefundDeadline.ToString("dd/MM/yyyy")</strong>)
                                                </div>
                                            </div>
                                            <div class="text-end">
                                                <span class="text-muted d-block" style="font-size: 0.75rem;">ยื่นเรื่องเมื่อ: @refundReq.RequestedAt.ToString("dd/MM/yyyy HH:mm น.")</span>
                                                <span class="badge bg-white text-dark border mt-1">ยอดเงินที่ขอคืน: ฿@refundReq.Amount.ToString("N2")</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else if (refundReq.Status == "Approved")
                                {
                                    <div class="alert alert-success border-0 rounded-4 p-3 mt-3 mb-0 small">
                                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                            <div>
                                                <span class="badge bg-success rounded-pill px-3 py-1 fw-bold mb-1">
                                                    <i class="bi bi-check-circle-fill me-1"></i> ฝ่ายบัญชีโอนเงินคืนเข้าบัญชีธนาคารเรียบร้อยแล้ว
                                                </span>
                                                <div class="text-dark fw-medium mt-1">
                                                    <i class="bi bi-bank me-1 text-success"></i> โอนคืนเข้า: <strong>@refundReq.BankName</strong> เลขที่ <strong>@refundReq.BankAccountNumber</strong> (@refundReq.BankAccountName)
                                                </div>
                                                <div class="text-muted mt-1" style="font-size: 0.8rem;">
                                                    วันที่ดำเนินการ: @(refundReq.ProcessedAt?.ToString("dd/MM/yyyy HH:mm น.") ?? "-") • ตรวจสอบโดย: @(refundReq.ProcessedBy ?? "ฝ่ายบัญชี")
                                                </div>
                                                @if (!string.IsNullOrEmpty(refundReq.AdminNote))
                                                {
                                                    <div class="text-muted small mt-1">บันทึก: @refundReq.AdminNote</div>
                                                }
                                            </div>
                                            <div class="text-end">
                                                <h5 class="fw-bold text-success mb-0">฿@refundReq.Amount.ToString("N2")</h5>
                                                <span class="badge bg-success bg-opacity-25 text-success border border-success">โอนคืนสำเร็จ</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else if (refundReq.Status == "Rejected")
                                {
                                    <div class="alert alert-danger border-0 rounded-4 p-3 mt-3 mb-0 small">
                                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                            <div>
                                                <span class="badge bg-danger rounded-pill px-3 py-1 fw-bold mb-1">
                                                    <i class="bi bi-x-circle-fill me-1"></i> คำขอคืนเงินถูกปฏิเสธโดยฝ่ายบัญชี
                                                </span>
                                                <div class="text-danger mt-1">
                                                    เหตุผล: <strong>@(refundReq.AdminNote ?? "ไม่ระบุ")</strong>
                                                </div>
                                                <small class="text-muted">พิจารณาเมื่อ: @(refundReq.ProcessedAt?.ToString("dd/MM/yyyy HH:mm น.") ?? "-") โดย @(refundReq.ProcessedBy ?? "ฝ่ายบัญชี")</small>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <!-- Modal ยื่นขอคืนเงินสำหรับรายการนี้ -->
                    @if (isEligible)
                    {
                        <div class="modal fade" id="refundModal-@booking.BookingId" tabindex="-1" aria-labelledby="refundModalLabel-@booking.BookingId" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                                <form class="modal-content border-0 rounded-4 shadow-lg overflow-hidden" asp-controller="Booking" asp-action="RequestRefund" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="BookingId" value="@booking.BookingId" />

                                    <div class="modal-header bg-danger text-white py-3 px-4">
                                        <h5 class="modal-title fw-bold" id="refundModalLabel-@booking.BookingId">
                                            <i class="bi bi-arrow-counterclockwise me-2"></i>ยื่นคำขอคืนเงินค่าห้องพัก
                                        </h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>

                                    <div class="modal-body p-4 bg-light" style="max-height: calc(85vh - 130px); overflow-y: auto;">
                                        <!-- ข้อมูลสรุปการจองที่จะขอคืน -->
                                        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white mb-3">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <span class="text-muted small">รหัสอ้างอิง:</span>
                                                <span class="fw-bold font-monospace text-primary">@booking.BookingRef</span>
                                            </div>
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <span class="text-muted small">ห้องพัก:</span>
                                                <span class="fw-medium text-dark">
                                                    @typeName
                                                    @if (booking.Room != null && (booking.BookingStatus == "CheckIn" || booking.BookingStatus == "CheckedIn" || booking.BookingStatus == "Completed"))
                                                    {
                                                        <span>(ห้อง @booking.Room.RoomNo - สาขา @branchTh)</span>
                                                    }
                                                    else
                                                    {
                                                        <span>(สาขา @branchTh)</span>
                                                    }
                                                </span>
                                            </div>
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <span class="text-muted small">วันที่จอง:</span>
                                                <span class="text-dark small">@bookingDate.ToString("dd/MM/yyyy")</span>
                                            </div>
                                            <hr class="my-2">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span class="fw-bold text-dark">ยอดเงินที่ขอคืนสุทธิ:</span>
                                                <h4 class="fw-bold text-danger m-0">฿@booking.TotalPrice.ToString("N2")</h4>
                                            </div>
                                        </div>

                                        <!-- กล่องเงื่อนไขตามข้อกำหนด -->
                                        <div class="alert alert-warning border-0 rounded-3 p-3 small mb-3">
                                            <div class="fw-bold text-dark mb-1">
                                                <i class="bi bi-shield-check text-warning me-1"></i> เงื่อนไขและกำหนดเวลาการคืนเงิน:
                                            </div>
                                            <ul class="mb-0 ps-3 text-muted" style="font-size: 0.82rem;">
                                                <li>สามารถยื่นขอคืนเงินได้<strong>ภายใน 7 วันหลังจากการจอง</strong> (รายการนี้เหลือเวลาอีก <strong>@daysRemaining วัน</strong>)</li>
                                                <li>ระบบจะส่งคำขอให้<strong>พนักงานฝ่ายบัญชี</strong>ตรวจสอบข้อมูลโดยตรง</li>
                                                <li>ฝ่ายบัญชีจะดำเนินการ<strong>โอนเงินคืนเข้าบัญชีธนาคารภายใน 3 วันทำการ</strong> (ภายในวันที่ <strong>@DateTime.Now.AddDays(3).ToString("dd/MM/yyyy")</strong>)</li>
                                            </ul>
                                        </div>

                                        <!-- ฟอร์มระบุบัญชีธนาคารสำหรับโอนเงินคืน -->
                                        <div class="bg-white p-3 rounded-3 shadow-sm border mb-3">
                                            <h6 class="fw-bold text-primary mb-3 small">
                                                <i class="bi bi-bank2 me-1"></i> กรอกข้อมูลบัญชีธนาคารสำหรับรับเงินคืน
                                            </h6>

                                            <div class="mb-3">
                                                <label class="form-label small fw-bold text-dark">เลือกธนาคารผู้รับเงิน <span class="text-danger">*</span></label>
                                                <select name="BankName" class="form-select form-select-sm border-primary" required>
                                                    <option value="">-- กรุณาเลือกธนาคาร --</option>
                                                    <option value="ธนาคารกสิกรไทย (KBANK)">ธนาคารกสิกรไทย (KBANK)</option>
                                                    <option value="ธนาคารไทยพาณิชย์ (SCB)">ธนาคารไทยพาณิชย์ (SCB)</option>
                                                    <option value="ธนาคารกรุงเทพ (BBL)">ธนาคารกรุงเทพ (BBL)</option>
                                                    <option value="ธนาคารกรุงไทย (KTB)">ธนาคารกรุงไทย (KTB)</option>
                                                    <option value="ธนาคารทหารไทยธนชาต (TTB)">ธนาคารทหารไทยธนชาต (TTB)</option>
                                                    <option value="ธนาคารกรุงศรีอยุธยา (BAY)">ธนาคารกรุงศรีอยุธยา (BAY)</option>
                                                    <option value="ธนาคารออมสิน (GSB)">ธนาคารออมสิน (GSB)</option>
                                                    <option value="พร้อมเพย์ (PromptPay)">พร้อมเพย์ (PromptPay)</option>
                                                </select>
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label small fw-bold text-dark">เลขที่บัญชีธนาคาร / เบอร์พร้อมเพย์ <span class="text-danger">*</span></label>
                                                <input type="text" name="BankAccountNumber" class="form-control form-control-sm font-monospace" placeholder="เช่น 012-3-45678-9 หรือ เบอร์โทรศัพท์" required />
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label small fw-bold text-dark">ชื่อเจ้าของบัญชี (ตรงกับชื่อผู้รับเงิน) <span class="text-danger">*</span></label>
                                                <input type="text" name="BankAccountName" class="form-control form-control-sm" value="@(booking.GuestName ?? booking.User?.FullName ?? "")" placeholder="เช่น นายสมชาย ใจดี" required />
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label small fw-bold text-dark">เบอร์โทรศัพท์ติดต่อ <span class="text-danger">*</span></label>
                                                <input type="tel" name="ContactPhone" class="form-control form-control-sm" value="@(booking.User?.Phone ?? "")" placeholder="เช่น 0812345678" required />
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label small fw-bold text-dark">เหตุผลในการขอคืนเงิน <span class="text-danger">*</span></label>
                                                <select name="Reason" id="refundReasonSelect-@booking.BookingId" class="form-select form-select-sm" onchange="toggleRefundReason('@booking.BookingId')" required>
                                                    <option value="เปลี่ยนแปลงแผนการเดินทางกะทันหัน">เปลี่ยนแปลงแผนการเดินทางกะทันหัน</option>
                                                    <option value="จองวันเข้าพักผิด / ต้องการจองใหม่">จองวันเข้าพักผิด / ต้องการจองใหม่</option>
                                                    <option value="มีเหตุจำเป็นส่วนตัวไม่สามารถเดินทางได้">มีเหตุจำเป็นส่วนตัวไม่สามารถเดินทางได้</option>
                                                    <option value="จองห้องพักผิดประเภท / ผิดสาขา">จองห้องพักผิดประเภท / ผิดสาขา</option>
                                                    <option value="อื่นๆ">อื่นๆ</option>
                                                </select>
                                            </div>

                                            <div id="otherReasonGroup-@booking.BookingId" class="mb-0" style="display: none;">
                                                <label class="form-label small fw-bold text-dark">
                                                    ระบุรายละเอียดเหตุผล <span class="text-danger">*</span>
                                                </label>
                                                <textarea name="OtherReason" id="otherReasonInput-@booking.BookingId" class="form-control form-control-sm" rows="3" placeholder="กรุณาระบุรายละเอียดหรือเหตุผลเพิ่มเติมในการขอคืนเงิน..."></textarea>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="modal-footer bg-white border-top py-3 px-4">
                                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">ยกเลิก</button>
                                        <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm" onclick="return confirm('ยืนยันการยื่นคำขอคืนเงินยอด ฿@booking.TotalPrice.ToString("N2")? ข้อมูลจะถูกส่งไปยังฝ่ายบัญชีเพื่อดำเนินการโอนคืนภายใน 3 วันทำการ');">
                                            <i class="bi bi-send-check me-1"></i> ยืนยันยื่นขอคืนเงิน
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    }
                }
            }
            else
            {
                <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
                    <i class="bi bi-journal-x display-1 text-muted mb-3"></i>
                    @if (hasSearched)
                    {
                        <h5 class="fw-bold">ไม่พบข้อมูลการจองที่ตรงกับคำค้นหา</h5>
                        <p class="text-muted small mb-4">กรุณาตรวจสอบหมายเลขการจอง (Booking Reference) หรืออีเมล/เบอร์โทรศัพท์อีกครั้ง</p>
                    }
                    else if (isLoggedIn)
                    {
                        <h5 class="fw-bold">คุณยังไม่มีประวัติการจองห้องพัก</h5>
                        <p class="text-muted small mb-4">เริ่มต้นค้นหาและชมพรีวิวห้องพักสุดหรูจากทั้ง 3 สาขาของเราได้เลย</p>
                    }
                    else
                    {
                        <h5 class="fw-bold">กรอกหมายเลขการจองเพื่อตรวจสอบสถานะ</h5>
                        <p class="text-muted small mb-4">หรือเข้าสู่ระบบด้วยบัญชีสมาชิกของคุณเพื่อดูประวัติการจองทั้งหมดโดยอัตโนมัติ</p>
                        <div class="d-flex justify-content-center gap-2">
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary rounded-pill px-4">
                                <i class="bi bi-box-arrow-in-right me-1"></i> เข้าสู่ระบบสมาชิก
                            </a>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4">
                                <i class="bi bi-house-door me-1"></i> ไปหน้าพรีวิวห้องพัก
                            </a>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleRefundReason(bookingId) {
            var sel = document.getElementById('refundReasonSelect-' + bookingId);
            var grp = document.getElementById('otherReasonGroup-' + bookingId);
            var txt = document.getElementById('otherReasonInput-' + bookingId);
            if (!sel || !grp) return;

            if (sel.value === 'อื่นๆ') {
                grp.style.display = 'block';
                if (txt) {
                    txt.required = true;
                    txt.focus();
                }
            } else {
                grp.style.display = 'none';
                if (txt) {
                    txt.required = false;
                    txt.value = '';
                }
            }
        }
    </script>
}

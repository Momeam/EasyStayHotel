@{
    ViewData["Title"] = "การจองสำเร็จ";
    var groupBookings = ViewBag.GroupBookings as List<EasyStayHotel.Models.Booking> ?? new List<EasyStayHotel.Models.Booking>();
    string baseRef = ViewBag.BaseBookingRef as string ?? (ViewBag.BookingRef as string ?? "");
    string primaryVoucherRef = ViewBag.PrimaryVoucherRef as string ?? (ViewBag.BookingRef as string ?? "");
}

<div class="container py-5 text-center" style="max-width: 640px;">
    <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white">
        <i class="bi bi-check-circle-fill text-success" style="font-size: 4.5rem;"></i>
        <h2 class="fw-bold mt-3 mb-2">การจองสำเร็จ!</h2>
        <p class="text-muted mb-4">
            ขอบคุณสำหรับการจองห้องพักกับ Easy Stay ระบบได้รับหลักฐานการชำระเงินของคุณเรียบร้อยแล้ว
            @if (groupBookings.Count > 1)
            {
                <span class="badge bg-primary rounded-pill ms-1">จองพร้อมกัน @groupBookings.Count ห้อง</span>
            }
        </p>
        
        <div class="bg-light p-4 rounded-3 mb-3 border">
            <p class="mb-1 text-muted small">หมายเลขการจองหลัก (Booking Reference)</p>
            <h3 class="fw-bold text-primary m-0 font-monospace">@baseRef</h3>

            @if (groupBookings.Count > 1)
            {
                <hr class="my-3 opacity-25" />
                <div class="text-start small">
                    <div class="fw-bold text-dark mb-2"><i class="bi bi-buildings me-1 text-primary"></i> รายการห้องพักที่จองทั้งหมด (@groupBookings.Count ห้อง):</div>
                    @for (int i = 0; i < groupBookings.Count; i++)
                    {
                        var b = groupBookings[i];
                        <div class="d-flex justify-content-between align-items-center bg-white border rounded-3 px-3 py-2 mb-1">
                            <div>
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary me-1">ห้องที่ @(i + 1)</span>
                                <strong class="text-dark">@(b.Room?.RoomType?.TypeName ?? "Standard Room")</strong>
                                <span class="text-muted font-monospace ms-1">(@b.BookingRef)</span>
                            </div>
                            <span class="fw-bold text-success">฿@b.TotalPrice.ToString("N2")</span>
                        </div>
                    }
                </div>
            }
        </div>
        
        <div class="alert alert-info border-0 rounded-3 text-start small mb-4 py-2 px-3">
            <i class="bi bi-info-circle me-1"></i> <strong>หมายเหตุ:</strong> หมายเลขห้องพักจริงจะถูกจัดสรรโดยพนักงานต้อนรับจากห้องที่ว่างตามประเภทห้องที่ท่านจอง เมื่อท่านเดินทางมาถึงและทำการเช็คอิน ณ โรงแรม
        </div>
        
        <p class="small text-muted mb-4">พนักงานของเรากำลังตรวจสอบรายการชำระเงิน คุณสามารถใช้หมายเลขการจองนี้เพื่อติดตามสถานะได้ตลอดเวลา</p>
        
        <div class="d-grid gap-2">
            <a asp-controller="Booking" asp-action="BookingVoucher" asp-route-bookingRef="@primaryVoucherRef" target="_blank" class="btn btn-success btn-lg fw-bold shadow-sm">
                <i class="bi bi-file-earmark-arrow-down-fill me-2"></i> พิมพ์ / ดาวน์โหลดเอกสารการจอง (Booking Voucher)
            </a>
            <a asp-controller="Booking" asp-action="MyBookings" asp-route-bookingRef="@baseRef" class="btn btn-outline-primary fw-bold">
                <i class="bi bi-journal-check me-1"></i> ตรวจสอบสถานะการจอง
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-light border fw-bold text-muted">
                กลับสู่หน้าหลัก
            </a>
        </div>
    </div>
</div>
@model EasyStayHotel.Models.ViewModels.CustomerCheckoutViewModel
@using EasyStayHotel.Services
@{
    ViewData["Title"] = "ขั้นตอนการจองและชำระเงิน";
    int rtId = ViewBag.RoomTypeId != null ? (int)ViewBag.RoomTypeId : 1;
    string branchNameTh = RoomPreviewHelper.GetBranchNameTh(ViewBag.RoomBranch as string);
    string roomMainImg = RoomPreviewHelper.GetMainImage(Model.RoomTypeName, rtId);
    string roomSize = RoomPreviewHelper.GetRoomSize(Model.RoomTypeName, rtId);
    string bedType = RoomPreviewHelper.GetBedType(Model.RoomTypeName, rtId);
    int roomsCount = ViewBag.RoomsCount != null ? (int)ViewBag.RoomsCount : 1;
    int nights = Model.Nights > 0 ? Model.Nights : 1;
    decimal initialRoomPrice = Model.BasePrice * nights * roomsCount;
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">ขั้นตอนการจองและเลือกบริการเสริม</h3>
            <p class="text-muted small mb-0">ตรวจสอบรายละเอียดห้องพัก เลือกบริการเสริม และชำระเงินผ่าน PromptPay</p>
        </div>
        <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> ย้อนกลับ
        </a>
    </div>

    <!-- ใช้ Form ครอบทั้งหมด เพื่อเตรียมส่งข้อมูลไปหลังบ้านตอนกดปุ่มยืนยัน -->
    <form asp-action="ConfirmBooking" asp-controller="Booking" method="post" enctype="multipart/form-data">
        
        <!-- ซ่อนข้อมูลที่จำเป็นไว้ไม่ให้ลูกค้าแก้ แต่ต้องส่งไปหลังบ้าน -->
        <input type="hidden" asp-for="RoomId" />
        <input type="hidden" asp-for="RoomTypeName" />
        <input type="hidden" name="CheckInDate" id="CheckInDate" value="@DateHelper.ToIsoDate(Model.CheckInDate)" />
        <input type="hidden" name="CheckOutDate" id="CheckOutDate" value="@DateHelper.ToIsoDate(Model.CheckOutDate)" />
        <input type="hidden" name="Nights" id="hiddenNights" value="@nights" />
        <input type="hidden" asp-for="Guests" />
        <input type="hidden" name="BasePrice" id="hiddenBasePrice" value="@Model.BasePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
        <input type="hidden" name="TotalPrice" id="hiddenTotalPrice" value="@initialRoomPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
        <input type="hidden" id="hiddenRoomsCount" value="@roomsCount" />

        <div class="row g-4">
            <!-- คอลัมน์ซ้าย: รายละเอียด, บริการเสริม, ชำระเงิน -->
            <div class="col-md-8">
                
                <!-- 1. ข้อมูลรายละเอียดการเข้าพัก + พรีวิวห้องที่เลือก -->
                <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
                    <div class="card-body p-4">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                            <h5 class="fw-bold text-primary m-0">
                                <i class="bi bi-door-open-fill me-1"></i> ข้อมูลห้องพักและการเข้าพัก
                            </h5>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary rounded-pill px-3 py-1">
                                    <i class="bi bi-geo-alt-fill me-1"></i>สาขา @(branchNameTh)
                                </span>
                                <span class="badge bg-light text-muted border rounded-pill px-2 py-1 small">
                                    <i class="bi bi-clock-history me-1 text-primary"></i>จัดสรรหมายเลขห้อง ณ วันเช็คอิน
                                </span>
                            </div>
                        </div>

                        <div class="row g-3 align-items-center mb-3">
                            <div class="col-sm-4">
                                <img src="@roomMainImg" class="img-fluid rounded-3 w-100" style="height: 140px; object-fit: cover;" alt="@Model.RoomTypeName" />
                            </div>
                            <div class="col-sm-8">
                                <h5 class="fw-bold text-dark mb-1">@Model.RoomTypeName</h5>
                                <div class="text-muted small mb-2">
                                    <span class="me-3"><i class="bi bi-arrows-fullscreen text-primary me-1"></i> @roomSize</span>
                                    <span><i class="bi bi-lamp-fill text-primary me-1"></i> @bedType</span>
                                </div>
                                <p class="text-muted small mb-2">
                                    เข้าพัก <strong id="uiHeaderNights">@nights คืน</strong>@(roomsCount > 1 ? $", {roomsCount} ห้อง" : ""), แขก <strong>@Model.Guests ท่าน</strong> • ฟรี Wi-Fi และอาหารเช้า
                                </p>
                                <span class="badge bg-success bg-opacity-10 text-success">
                                    <i class="bi bi-shield-check me-1"></i> ยกเลิกฟรีล่วงหน้า 3 วันก่อนเข้าพัก
                                </span>
                            </div>
                        </div>

                        <!-- ส่วนเลือกและปรับเปลี่ยนวันเข้าพัก/วันเช็คเอาท์ (Interactive Date Selector) -->
                        <div class="row bg-light p-3 rounded-3 g-3 align-items-center mb-0 border">
                            <div class="col-md-5">
                                <label for="uiCheckInDate" class="form-label small fw-bold text-dark mb-1">
                                    <i class="bi bi-calendar-event text-primary me-1"></i> วันที่เช็คอิน (Check-in 14:00 น.) *
                                </label>
                                <input type="date" id="uiCheckInDate" class="form-control fw-semibold border-primary bg-white shadow-none"
                                       value="@DateHelper.ToIsoDate(Model.CheckInDate)"
                                       min="@DateHelper.ToIsoDate(DateTime.Today)" required />
                                <small class="text-muted d-block mt-1" id="uiCheckInThaiText">
                                    <i class="bi bi-calendar2-check text-muted me-1"></i>@DateHelper.ToThaiDisplayDate(Model.CheckInDate)
                                </small>
                            </div>
                            <div class="col-md-5">
                                <label for="uiCheckOutDate" class="form-label small fw-bold text-dark mb-1">
                                    <i class="bi bi-calendar-check text-primary me-1"></i> วันที่เช็คเอาท์ (Check-out 12:00 น.) *
                                </label>
                                <input type="date" id="uiCheckOutDate" class="form-control fw-semibold border-primary bg-white shadow-none"
                                       value="@DateHelper.ToIsoDate(Model.CheckOutDate)"
                                       min="@DateHelper.ToIsoDate(Model.CheckInDate.AddDays(1))" required />
                                <small class="text-muted d-block mt-1" id="uiCheckOutThaiText">
                                    <i class="bi bi-calendar2-check text-muted me-1"></i>@DateHelper.ToThaiDisplayDate(Model.CheckOutDate)
                                </small>
                            </div>
                            <div class="col-md-2 text-center">
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-3 py-2 rounded-pill mt-md-3 d-inline-block">
                                    <i class="bi bi-moon-stars me-1"></i> <span id="uiNightsBadge">@nights</span> คืน
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. ข้อมูลผู้จอง -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4">
                        <h5 class="fw-bold text-primary mb-3">
                            <i class="bi bi-person-vcard-fill me-1"></i> ข้อมูลผู้เข้าพัก
                        </h5>
                        <div class="row g-3">
                            <div class="col-md-12">
                                <label class="form-label small fw-bold">ชื่อ-นามสกุล *</label>
                                <input asp-for="GuestName" type="text" class="form-control" placeholder="ระบุชื่อ-นามสกุลผู้เข้าพัก" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">อีเมล (สำหรับรับใบยืนยันและเช็คสิทธิ์เดือนเกิด) *</label>
                                <input asp-for="Email" type="email" class="form-control" placeholder="email@example.com" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">เบอร์โทรศัพท์ *</label>
                                <input asp-for="Phone" type="text" class="form-control" placeholder="08X-XXX-XXXX" required />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. บริการเสริม (Add-on Services) -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4">
                        <h5 class="fw-bold text-primary mb-2">บริการเสริมพิเศษ (Add-on Services)</h5>
                        <p class="text-muted small mb-4">เลือกบริการเสริมเพื่อยกระดับความสะดวกสบายในการพักผ่อนของคุณ</p>
                        
                        <!-- เตียงเสริม -->
                        <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                            <div>
                                <h6 class="fw-bold m-0">เตียงเสริม (Extra Bed)</h6>
                                <span class="text-muted small">สูงสุด 1 เตียงต่อห้องพัก (฿800 / คืน)</span>
                            </div>
                            <div class="input-group" style="width: 120px;">
                                <button type="button" class="btn btn-outline-secondary btn-sm btn-minus" data-target="ExtraBedCount">-</button>
                                <input asp-for="ExtraBedCount" type="number" class="form-control form-control-sm text-center addon-input" min="0" max="1" readonly />
                                <button type="button" class="btn btn-outline-secondary btn-sm btn-plus" data-target="ExtraBedCount">+</button>
                            </div>
                        </div>

                        <!-- อาหารเช้า -->
                        <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                            <div>
                                <h6 class="fw-bold m-0">อาหารเช้าเพิ่มเติม (Breakfast Buffet)</h6>
                                <span class="text-muted small">บุฟเฟต์นานาชาติ ณ ห้องอาหารของโรงแรม (฿350 / คน / วัน)</span>
                            </div>
                            <div class="input-group" style="width: 120px;">
                                <button type="button" class="btn btn-outline-secondary btn-sm btn-minus" data-target="BreakfastCount">-</button>
                                <input asp-for="BreakfastCount" type="number" class="form-control form-control-sm text-center addon-input" min="0" max="10" readonly />
                                <button type="button" class="btn btn-outline-secondary btn-sm btn-plus" data-target="BreakfastCount">+</button>
                            </div>
                        </div>

                        <!-- รถรับส่งสนามบิน -->
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                <h6 class="fw-bold m-0">รถรับส่งสนามบิน (Airport Transfer)</h6>
                                <span class="text-muted small">รถตู้พรีเมียม VIP เที่ยวเดียวหรือไปกลับ (฿1,200 / เที่ยว)</span>
                            </div>
                            <div class="input-group" style="width: 120px;">
                                <button type="button" class="btn btn-outline-secondary btn-sm btn-minus" data-target="TransferCount">-</button>
                                <input asp-for="TransferCount" type="number" class="form-control form-control-sm text-center addon-input" min="0" max="2" readonly />
                                <button type="button" class="btn btn-outline-secondary btn-sm btn-plus" data-target="TransferCount">+</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 4. ช่องทางการชำระเงินที่ปลอดภัย -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4 text-center">
                        <h5 class="fw-bold text-primary mb-4 text-start">ช่องทางการชำระเงินที่ปลอดภัย</h5>
                        <h6 class="fw-bold mb-3"><i class="bi bi-wallet2"></i> PromptPay (พร้อมเพย์)</h6>
                        
                        <img id="qrCodeImg" src="https://promptpay.io/0983813674/@(initialRoomPrice).png" class="img-fluid border p-2 rounded mb-3" style="width: 200px;" alt="PromptPay QR Code" />
                        <p class="text-muted small mb-4">สแกน QR Code เพื่อชำระยอดรวมด้วยแอปธนาคารของคุณ</p>

                        <div class="text-start">
                            <label class="form-label fw-bold small">อัปโหลดหลักฐานสลิปการโอนเงิน *</label>
                            <input asp-for="PaymentSlip" type="file" class="form-control" accept="image/*" required />
                        </div>
                    </div>
                </div>
            </div>

            <!-- คอลัมน์ขวา: สรุปค่าใช้จ่าย -->
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 20px;">
                    <div class="card-body p-4">
                        <h5 class="fw-bold text-primary mb-4">สรุปค่าใช้จ่ายทั้งหมด</h5>
                        
                        <div class="d-flex justify-content-between small mb-2">
                            <span class="text-muted">ค่าห้องพัก <span id="uiSummaryNights">(@nights คืน@(roomsCount > 1 ? $", {roomsCount} ห้อง" : ""))</span></span>
                            <span class="fw-bold" id="uiRoomPrice">฿@initialRoomPrice.ToString("N0")</span>
                        </div>
                        
                        <div id="uiAddonSection">
                            <!-- จะถูกเพิ่ม HTML ด้วย JavaScript ถ้ามีการเลือก Add-on -->
                        </div>

                        <hr class="opacity-25 my-3" />

                        <!-- ส่วนลด -->
                        <div class="d-flex justify-content-between small text-danger mb-3 d-none" id="uiDiscountSection">
                            <span>ส่วนลดโปรโมชั่น</span>
                            <span class="fw-bold" id="uiDiscountAmount">-฿0</span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h6 class="fw-bold m-0">ยอดรวมสุทธิชำระ</h6>
                            <h4 class="fw-bold text-success m-0" id="uiGrandTotal">฿@initialRoomPrice.ToString("N0")</h4>
                        </div>

                        <!-- โค้ดส่วนลดและโปรโมชั่น -->
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted mb-1">
                                <i class="bi bi-ticket-perforated text-primary me-1"></i> โค้ดส่วนลด / คูปองโปรโมชั่น
                            </label>
                            <div class="input-group mb-2">
                                <input asp-for="PromoCode" type="text" class="form-control text-uppercase" placeholder="กรอกรหัสคูปอง เช่น GROUP15" />
                                <button class="btn btn-outline-primary fw-semibold px-3" type="button" id="btnApplyPromo">ใช้คูปอง</button>
                            </div>
                            <div class="d-flex flex-wrap gap-1 align-items-center mb-2">
                                <span class="text-muted small me-1" style="font-size: 0.78rem;">คูปองแนะนำ:</span>
                                <button type="button" class="badge bg-light text-primary border border-primary border-opacity-25 quick-promo-chip py-1 px-2" data-code="EARLYBIRD" title="จองล่วงหน้า >30 วัน รับส่วนลด 15%">
                                    EARLYBIRD (-15%)
                                </button>
                                <button type="button" class="badge bg-light text-primary border border-primary border-opacity-25 quick-promo-chip py-1 px-2" data-code="LONGSTAY" title="พักต่อเนื่อง 3 คืนขึ้นไป ลด 10% คืนที่ 3">
                                    LONGSTAY (-10% คืนที่ 3)
                                </button>
                                <button type="button" class="badge bg-light text-primary border border-primary border-opacity-25 quick-promo-chip py-1 px-2" data-code="GROUP15" title="จองตั้งแต่ 2 ห้องขึ้นไป รับส่วนลด 15% ทุกห้อง">
                                    GROUP15 (-15% กลุ่ม)
                                </button>
                                <button type="button" class="badge bg-light text-primary border border-primary border-opacity-25 quick-promo-chip py-1 px-2" data-code="BIRTHDAY10" title="เข้าพักในเดือนเกิด รับส่วนลด 10%">
                                    BIRTHDAY10 (-10% เดือนเกิด)
                                </button>
                                <button type="button" class="badge bg-light text-primary border border-primary border-opacity-25 quick-promo-chip py-1 px-2" data-code="WEEKDAY5" title="พักวันธรรมดา จันทร์-พฤหัสฯ Deluxe+ รับส่วนลด 5%">
                                    WEEKDAY5 (-5% วันธรรมดา)
                                </button>
                            </div>
                        </div>

                        <!-- คำอธิบายเงื่อนไขโปรโมชั่นของโรงแรม -->
                        <div class="card border-0 bg-light p-3 rounded-3 mb-4">
                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-gift-fill text-warning me-2"></i>
                                <span class="fw-bold small text-dark">สิทธิพิเศษโปรโมชั่น Easy Stay:</span>
                            </div>
                            <ul class="small text-muted mb-0 ps-3" style="font-size: 0.78rem; line-height: 1.6;">
                                <li><strong>Early Bird:</strong> จองล่วงหน้า > 30 วัน ลด 15% ทันที (อัตโนมัติ / โค้ด <code>EARLYBIRD</code>)</li>
                                <li><strong>พักยาวคุ้มกว่า:</strong> จอง 3 คืนขึ้นไป ลดราคาคืนที่ 3 ลง 10% (อัตโนมัติ / โค้ด <code>LONGSTAY</code>)</li>
                                <li><strong>ต้อนรับเดือนเกิด:</strong> พักในเดือนเกิดของตนเอง ลด 10% (อัตโนมัติ / โค้ด <code>BIRTHDAY10</code>)</li>
                                <li><strong>เข้าพักแบบกลุ่ม:</strong> จองตั้งแต่ 2 ห้องขึ้นไป รับส่วนลด 15% ทุกห้อง (กรอกคูปอง <code>GROUP15</code>)</li>
                                <li><strong>วันธรรมดาน่าพัก:</strong> พัก จันทร์ - พฤหัสฯ ห้อง Deluxe ขึ้นไป ลดเพิ่ม 5% (อัตโนมัติ / โค้ด <code>WEEKDAY5</code>)</li>
                            </ul>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-3 fw-bold rounded-3 shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> ยืนยันและจองห้องพักตอนนี้
                        </button>
                        <p class="text-center text-muted small mt-3 mb-0">คุณจะได้รับหมายเลขการจองทันทีหลังจากส่งหลักฐานการชำระเงิน</p>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            const rawBase = $('#hiddenBasePrice').val() || '0';
            const baseRoomPrice = parseFloat(rawBase) || 0;
            const roomsCount = parseInt($('#hiddenRoomsCount').val()) || 1;
            
            const priceExtraBed = 800;
            const priceBreakfast = 350;
            const priceTransfer = 1200;

            const thaiMonthsShort = ["", "ม.ค.", "ก.พ.", "มี.ค.", "เม.ย.", "พ.ค.", "มิ.ย.", "ก.ค.", "ส.ค.", "ก.ย.", "ต.ค.", "พ.ย.", "ธ.ค."];
            
            // แปลงสตริง ISO (yyyy-MM-dd) เป็นรูปแบบแสดงผลภาษาไทยพร้อมปี พ.ศ. ที่ถูกต้อง
            function formatThaiDateDisplay(isoStr) {
                if (!isoStr) return '';
                const parts = isoStr.split('-');
                if (parts.length < 3) return isoStr;
                const y = parseInt(parts[0], 10);
                const m = parseInt(parts[1], 10);
                const d = parseInt(parts[2], 10);
                const thaiYear = y < 2400 ? (y + 543) : (y >= 3000 ? y - 1086 + 543 : y);
                return `${d} ${thaiMonthsShort[m] || ''} ${thaiYear}`;
            }

            // จัดการการเปลี่ยนวันเข้าพัก/วันเช็คเอาท์ และคำนวณจำนวนคืนใหม่
            function syncDatesAndRecalculate() {
                const inVal = $('#uiCheckInDate').val();
                let outVal = $('#uiCheckOutDate').val();
                if (!inVal || !outVal) return;

                const inDate = new Date(inVal + 'T00:00:00');
                let outDate = new Date(outVal + 'T00:00:00');

                // วันเช็คเอาท์ต้องมากกว่าวันเช็คอินอย่างน้อย 1 คืน
                if (outDate <= inDate) {
                    const nextDate = new Date(inDate);
                    nextDate.setDate(nextDate.getDate() + 1);
                    const y = nextDate.getFullYear();
                    const m = String(nextDate.getMonth() + 1).padStart(2, '0');
                    const d = String(nextDate.getDate()).padStart(2, '0');
                    outVal = `${y}-${m}-${d}`;
                    $('#uiCheckOutDate').val(outVal);
                    outDate = nextDate;
                }

                // ปรับ min ของช่องเช็คเอาท์ให้อยู่หลังจากวันเช็คอินอย่างน้อย 1 วัน
                const minOutDate = new Date(inDate);
                minOutDate.setDate(minOutDate.getDate() + 1);
                const minY = minOutDate.getFullYear();
                const minM = String(minOutDate.getMonth() + 1).padStart(2, '0');
                const minD = String(minOutDate.getDate()).padStart(2, '0');
                $('#uiCheckOutDate').attr('min', `${minY}-${minM}-${minD}`);

                // คำนวณจำนวนคืนใหม่
                const diffTime = outDate.getTime() - inDate.getTime();
                let nights = Math.round(diffTime / (1000 * 3600 * 24));
                if (nights < 1) nights = 1;

                // ซิงค์ค่าไปยัง Hidden Inputs สำหรับ Submit ข้อมูล
                $('#CheckInDate').val(inVal);
                $('#CheckOutDate').val(outVal);
                $('#hiddenNights').val(nights);

                // อัปเดตข้อความบน UI
                $('#uiNightsBadge').text(nights);
                $('#uiHeaderNights').text(`${nights} คืน`);
                $('#uiSummaryNights').text(`(${nights} คืน${roomsCount > 1 ? ', ' + roomsCount + ' ห้อง' : ''})`);
                $('#uiCheckInThaiText').html(`<i class="bi bi-calendar2-check text-muted me-1"></i>${formatThaiDateDisplay(inVal)}`);
                $('#uiCheckOutThaiText').html(`<i class="bi bi-calendar2-check text-muted me-1"></i>${formatThaiDateDisplay(outVal)}`);

                // คำนวณยอดเงินและตรวจสอบโปรโมชั่นใหม่
                calculateSummary();
            }

            $('#uiCheckInDate').on('change', syncDatesAndRecalculate);
            $('#uiCheckOutDate').on('change', syncDatesAndRecalculate);

            function calculateSummary() {
                const currentNights = parseInt($('#hiddenNights').val()) || 1;
                const totalRoomPrice = baseRoomPrice * currentNights * roomsCount;
                let totalAddons = 0;
                let addonHtml = '';

                // คำนวณบริการเสริมต่างๆ
                const bedQty = parseInt($('#ExtraBedCount').val()) || 0;
                if (bedQty > 0) {
                    totalAddons += bedQty * priceExtraBed * currentNights;
                    addonHtml += `<div class="d-flex justify-content-between small mb-2"><span class="text-muted">บริการเสริม: เตียงเสริม (${currentNights} คืน)</span><span class="fw-bold">฿${(bedQty * priceExtraBed * currentNights).toLocaleString()}</span></div>`;
                }

                const bfQty = parseInt($('#BreakfastCount').val()) || 0;
                if (bfQty > 0) {
                    totalAddons += bfQty * priceBreakfast * currentNights;
                    addonHtml += `<div class="d-flex justify-content-between small mb-2"><span class="text-muted">บริการเสริม: อาหารเช้า (${currentNights} คืน)</span><span class="fw-bold">฿${(bfQty * priceBreakfast * currentNights).toLocaleString()}</span></div>`;
                }

                const transQty = parseInt($('#TransferCount').val()) || 0;
                if (transQty > 0) {
                    totalAddons += transQty * priceTransfer;
                    addonHtml += `<div class="d-flex justify-content-between small mb-2"><span class="text-muted">บริการเสริม: รถรับส่ง</span><span class="fw-bold">฿${(transQty * priceTransfer).toLocaleString()}</span></div>`;
                }

                const subTotal = totalRoomPrice + totalAddons;

                // 1. อัปเดตราคาทันทีเสมอเพื่อป้องกันการแสดง ฿0
                $('#uiRoomPrice').text(`฿${totalRoomPrice.toLocaleString()}`);
                $('#uiAddonSection').html(addonHtml);
                $('#uiGrandTotal').text(`฿${subTotal.toLocaleString()}`);
                $('#hiddenTotalPrice').val(subTotal);
                $('#qrCodeImg').attr('src', `https://promptpay.io/0983813674/${subTotal}.png`);

                // 2. ส่งข้อมูลไปถาม Backend เพื่อคำนวณส่วนลดโปรโมชั่น
                const checkInVal = $('#CheckInDate').val() || $('#uiCheckInDate').val() || '';
                const requestData = {
                    BasePrice: baseRoomPrice,
                    Nights: currentNights,
                    Rooms: roomsCount,
                    CheckInDate: checkInVal,
                    CouponCode: $('#PromoCode').val() || '',
                    Email: $('#Email').val() || '',
                    RoomTypeName: '@Html.Raw(Model.RoomTypeName)'
                };

                $.ajax({
                    url: '/Booking/CalculateDiscount',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(requestData),
                    success: function (response) {
                        let finalTotal = subTotal;
                        let discountHtml = '';

                        // ถ้าโค้ดผิดพลาดให้แจ้งเตือนและเคลียร์ช่อง
                        if ($('#PromoCode').val() && response && !response.success) {
                            alert(response.message || 'รหัสส่วนลดไม่ถูกต้อง');
                            $('#PromoCode').val(''); 
                            calculateSummary(); // คำนวณใหม่โดยไม่มีคูปอง
                            return;
                        }

                        // ถ้ามีส่วนลด (ไม่ว่าจะอัตโนมัติหรือคูปอง)
                        if (response && response.discount > 0) {
                            finalTotal = Math.max(0, subTotal - response.discount);
                            $('#uiDiscountSection').removeClass('d-none');
                            $('#uiDiscountAmount').text(`-฿${response.discount.toLocaleString()}`);
                            
                            // แสดงป้ายชื่อโปรโมชั่น
                            let promoNames = (response.promotions || []).join(' และ ');
                            discountHtml = `<div class="d-flex justify-content-between small mb-2 text-success"><span class="fw-bold"><i class="bi bi-tag-fill"></i> โปรโมชั่นที่ใช้:</span><span class="text-end">${promoNames}</span></div>`;
                        } else {
                            $('#uiDiscountSection').addClass('d-none');
                        }

                        // อัปเดต UI ยอดรวมหลังหักส่วนลด
                        $('#uiAddonSection').html(addonHtml + discountHtml);
                        $('#uiGrandTotal').text(`฿${finalTotal.toLocaleString()}`);
                        $('#hiddenTotalPrice').val(finalTotal);
                        $('#qrCodeImg').attr('src', `https://promptpay.io/0983813674/${finalTotal}.png`);
                    },
                    error: function (xhr, status, error) {
                        console.warn("ระบบโปรโมชั่นไม่ตอบสนอง ใช้ราคาปกติ:", error);
                        $('#uiDiscountSection').addClass('d-none');
                    }
                });
            }

            // จัดการปุ่ม + และ - ของบริการเสริม
            $('.btn-plus').click(function () {
                const input = $('#' + $(this).data('target'));
                const max = parseInt(input.attr('max')) || 10;
                const current = parseInt(input.val()) || 0;
                if (current < max) {
                    input.val(current + 1);
                    calculateSummary();
                }
            });

            $('.btn-minus').click(function () {
                const input = $('#' + $(this).data('target'));
                const min = parseInt(input.attr('min')) || 0;
                const current = parseInt(input.val()) || 0;
                if (current > min) {
                    input.val(current - 1);
                    calculateSummary();
                }
            });

            // ตรวจจับการกดปุ่ม "ใช้รหัส"
            $('#btnApplyPromo').click(function () {
                if (!$('#PromoCode').val().trim()) {
                    alert('กรุณากรอกรหัสโปรโมชั่น');
                    return;
                }
                calculateSummary();
            });

            // กดเลือกชิปโค้ดส่วนลดด่วน
            $('.quick-promo-chip').click(function () {
                $('#PromoCode').val($(this).data('code'));
                calculateSummary();
            });

            // เมื่อกรอกอีเมลเสร็จ ให้เช็คสิทธิ์ส่วนลดเดือนเกิดใหม่
            $('#Email').on('change', function () {
                calculateSummary();
            });

            // คำนวณทันทีเมื่อโหลดหน้าเว็บ (เพื่อให้ส่วนลดอัตโนมัติทำงาน)
            calculateSummary();
        });
    </script>
}
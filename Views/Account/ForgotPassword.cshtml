@model EasyStayHotel.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "ลืมรหัสผ่าน / ตั้งรหัสผ่านใหม่";
}

<style>
    .auth-container {
        max-width: 960px;
    }
    .auth-banner-side {
        background: linear-gradient(135deg, rgba(15, 23, 42, 0.95) 0%, rgba(220, 53, 69, 0.85) 100%),
                    url('https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1000&q=80') center/cover no-repeat;
    }
    .input-group-text {
        border-color: #dee2e6;
    }
    .form-control:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);
    }
    .otp-input-field {
        font-size: 1.5rem;
        letter-spacing: 0.5rem;
        text-align: center;
        font-weight: 700;
        font-family: monospace;
    }
    .step-badge {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        font-weight: 700;
    }
</style>

<div class="container py-5 my-md-4">
    <div class="row justify-content-center">
        <div class="col-12 auth-container">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
                <div class="row g-0">
                    
                    <!-- ฝั่งซ้าย: แบนเนอร์ความปลอดภัย & ข้อมูลแนะนำ -->
                    <div class="col-lg-5 auth-banner-side text-white p-4 p-md-5 d-flex flex-column justify-content-between position-relative">
                        <div>
                            <div class="d-inline-flex align-items-center gap-2 bg-white bg-opacity-20 rounded-pill px-3 py-1 mb-4">
                                <i class="bi bi-shield-lock-fill text-warning"></i>
                                <span class="small fw-medium">Password Recovery</span>
                            </div>
                            <h3 class="fw-bold mb-3">ลืมรหัสผ่านบัญชี?</h3>
                            <p class="text-white-50 small mb-4">
                                ไม่ต้องกังวล คุณสามารถตั้งรหัสผ่านใหม่ได้อย่างปลอดภัยและรวดเร็วผ่านการยืนยันรหัส OTP ทางอีเมลที่ลงทะเบียนไว้
                            </p>
                        </div>

                        <div class="my-3">
                            <div class="d-flex align-items-start gap-3 mb-3">
                                <div class="bg-white bg-opacity-20 rounded-circle p-2 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 38px; height: 38px;">
                                    <span class="fw-bold">1</span>
                                </div>
                                <div class="small">
                                    <div class="fw-bold">กรอกอีเมลที่ลงทะเบียน</div>
                                    <div class="text-white-50">ระบบจะตรวจสอบและส่งรหัส OTP ไปที่กล่องข้อความของคุณ</div>
                                </div>
                            </div>

                            <div class="d-flex align-items-start gap-3 mb-3">
                                <div class="bg-white bg-opacity-20 rounded-circle p-2 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 38px; height: 38px;">
                                    <span class="fw-bold">2</span>
                                </div>
                                <div class="small">
                                    <div class="fw-bold">รับรหัส OTP 6 หลัก</div>
                                    <div class="text-white-50">รหัสยืนยันมีอายุ 5 นาที เพื่อความปลอดภัยของบัญชี</div>
                                </div>
                            </div>

                            <div class="d-flex align-items-start gap-3">
                                <div class="bg-white bg-opacity-20 rounded-circle p-2 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 38px; height: 38px;">
                                    <span class="fw-bold">3</span>
                                </div>
                                <div class="small">
                                    <div class="fw-bold">ตั้งรหัสผ่านใหม่และเข้าสู่ระบบ</div>
                                    <div class="text-white-50">กำหนดรหัสผ่านใหม่ได้ทันทีเพื่อใช้งานระบบได้อย่างต่อเนื่อง</div>
                                </div>
                            </div>
                        </div>

                        <div class="pt-4 border-top border-white border-opacity-25 small text-white-50">
                            &copy; @DateTime.Now.Year Easy Stay Hotel & Resort
                        </div>
                    </div>

                    <!-- ฝั่งขวา: แบบฟอร์มขอ OTP และตั้งรหัสผ่านใหม่ -->
                    <div class="col-lg-7 p-4 p-md-5 d-flex flex-column justify-content-center">
                        <div class="mb-4">
                            <span class="text-danger fw-bold small text-uppercase letter-spacing-1">
                                <i class="bi bi-shield-check me-1"></i>Security Verification
                            </span>
                            <h3 class="fw-bold text-dark mt-1 mb-1">ตั้งรหัสผ่านใหม่</h3>
                            <p class="text-muted small">กรอกอีเมลของท่านเพื่อขอรับรหัสยืนยัน OTP ในการรีเซ็ตรหัสผ่าน</p>
                        </div>

                        <!-- แจ้งเตือนข้อผิดพลาดถ้ามี -->
                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 py-3 mb-4" role="alert">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
                                    <span class="small fw-medium">@ViewBag.Error</span>
                                </div>
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        <!-- กล่องแจ้งเตือนผลการส่ง OTP ทาง AJAX -->
                        <div id="otpStatusAlert" class="alert d-none border-0 shadow-sm rounded-3 py-3 mb-4" role="alert">
                            <div class="d-flex align-items-center gap-2">
                                <i id="otpStatusIcon" class="bi fs-5"></i>
                                <span id="otpStatusText" class="small fw-medium"></span>
                            </div>
                        </div>

                        <!-- กล่องจำลอง OTP สำหรับโหมดพัฒนา -->
                        <div id="devOtpBox" class="alert alert-info border-0 py-2 px-3 small rounded-3 mb-3 d-none">
                            <div class="d-flex align-items-center justify-content-between">
                                <span><i class="bi bi-lightning-charge-fill text-warning me-1"></i> รหัส OTP สำหรับทดสอบ:</span>
                                <strong class="fs-6 text-primary" id="devOtpCodeText"></strong>
                            </div>
                        </div>

                        <form asp-controller="Account" asp-action="ResetPassword" method="post" id="resetPasswordForm">
                            @Html.AntiForgeryToken()

                            <!-- ขั้นตอนที่ 1: กรอกอีเมลและขอรหัส OTP -->
                            <div class="mb-4 pb-3 border-bottom">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="step-badge bg-primary text-white">1</span>
                                    <label asp-for="Email" class="form-label small fw-bold text-dark mb-0">อีเมลที่ลงทะเบียน</label>
                                </div>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted">
                                        <i class="bi bi-envelope-at"></i>
                                    </span>
                                    <input asp-for="Email" type="email" id="forgotEmailInput" class="form-control"
                                           placeholder="example@easystay.com" required />
                                    <button class="btn btn-outline-primary px-3 fw-medium" type="button" id="btnSendOtp">
                                        <span id="btnSendOtpSpinner" class="spinner-border spinner-border-sm me-1 d-none" role="status"></span>
                                        <i class="bi bi-send me-1" id="btnSendOtpIcon"></i>
                                        <span id="btnSendOtpText">ขอรับ OTP</span>
                                    </button>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-1">
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                    <span id="countdownSpan" class="text-muted small d-none">
                                        <i class="bi bi-clock me-1"></i>ขอรหัสใหม่ได้ใน <strong class="text-danger" id="countdownSeconds">60</strong> วินาที
                                    </span>
                                </div>
                            </div>

                            <!-- ขั้นตอนที่ 2: กรอก OTP และรหัสผ่านใหม่ (แสดงตลอด แต่จะไฮไลท์เมื่อส่ง OTP แล้ว) -->
                            <div id="step2Container">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="step-badge bg-secondary text-white" id="step2Badge">2</span>
                                    <label class="form-label small fw-bold text-dark mb-0">กรอกรหัสยืนยัน OTP และรหัสผ่านใหม่</label>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="OtpCode" class="form-label small fw-medium text-muted">รหัส OTP 6 หลัก จากอีเมล</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-muted">
                                            <i class="bi bi-shield-check"></i>
                                        </span>
                                        <input asp-for="OtpCode" type="text" id="otpCodeInput" maxlength="6"
                                               class="form-control otp-input-field" placeholder="••••••"
                                               autocomplete="one-time-code" inputmode="numeric" required />
                                    </div>
                                    <span asp-validation-for="OtpCode" class="text-danger small"></span>
                                </div>

                                <div class="row g-2 mb-4">
                                    <div class="col-md-6">
                                        <label asp-for="NewPassword" class="form-label small fw-medium text-muted">รหัสผ่านใหม่</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light text-muted"><i class="bi bi-lock"></i></span>
                                            <input asp-for="NewPassword" type="password" id="inputNewPass"
                                                   class="form-control border-end-0" placeholder="อย่างน้อย 6 ตัวอักษร" required />
                                            <button class="btn btn-outline-secondary border-start-0" type="button" onclick="togglePass('inputNewPass', this)">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </div>
                                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                                    </div>

                                    <div class="col-md-6">
                                        <label asp-for="ConfirmNewPassword" class="form-label small fw-medium text-muted">ยืนยันรหัสผ่านใหม่</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light text-muted"><i class="bi bi-lock-fill"></i></span>
                                            <input asp-for="ConfirmNewPassword" type="password" id="inputConfirmPass"
                                                   class="form-control border-end-0" placeholder="ระบุอีกครั้ง" required />
                                            <button class="btn btn-outline-secondary border-start-0" type="button" onclick="togglePass('inputConfirmPass', this)">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </div>
                                        <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                                    </div>
                                </div>

                                <button type="submit" class="btn btn-primary w-100 py-3 fw-bold rounded-3 shadow-sm mb-3" id="btnSubmitReset">
                                    <i class="bi bi-check2-circle me-1"></i> ยืนยันและบันทึกรหัสผ่านใหม่
                                </button>
                            </div>

                            <div class="text-center pt-3 border-top">
                                <a asp-controller="Account" asp-action="Login" class="text-decoration-none fw-medium text-muted small">
                                    <i class="bi bi-arrow-left me-1"></i> นึกรหัสผ่านได้แล้ว? กลับไปหน้าเข้าสู่ระบบ
                                </a>
                            </div>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePass(id, btn) {
            const input = document.getElementById(id);
            const icon = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }

        $(document).ready(function () {
            let countdownInterval = null;

            $('#btnSendOtp').on('click', function () {
                const email = $('#forgotEmailInput').val().trim();
                const alertBox = $('#otpStatusAlert');
                const alertIcon = $('#otpStatusIcon');
                const alertText = $('#otpStatusText');
                const devOtpBox = $('#devOtpBox');
                const devOtpCodeText = $('#devOtpCodeText');

                if (!email) {
                    alertBox.removeClass('d-none alert-success').addClass('alert-danger');
                    alertIcon.removeClass('bi-check-circle-fill text-success').addClass('bi-exclamation-triangle-fill text-danger');
                    alertText.text('กรุณากรอกอีเมลที่ลงทะเบียนไว้ก่อนขอรับรหัส OTP');
                    return;
                }

                // ปิดการคลิกซ้ำ และแสดง Spinner
                const btn = $(this);
                btn.prop('disabled', true);
                $('#btnSendOtpSpinner').removeClass('d-none');
                $('#btnSendOtpIcon').addClass('d-none');
                $('#btnSendOtpText').text('กำลังส่ง...');

                // ส่งคำขอ AJAX
                $.ajax({
                    url: '@Url.Action("SendForgotPasswordOtp", "Account")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ email: email }),
                    success: function (res) {
                        if (res.success) {
                            alertBox.removeClass('d-none alert-danger').addClass('alert-success');
                            alertIcon.removeClass('bi-exclamation-triangle-fill text-danger').addClass('bi-check-circle-fill text-success');
                            alertText.html(res.message + ' (ส่งไปยัง <strong>' + res.email + '</strong> เรียบร้อยแล้ว)');

                            $('#step2Badge').removeClass('bg-secondary').addClass('bg-success');

                            // แสดง Dev OTP (ถ้ามี)
                            if (res.devOtp) {
                                devOtpCodeText.text(res.devOtp);
                                devOtpBox.removeClass('d-none');
                                // กรอกลงช่องให้อัตโนมัติเพื่อความสะดวก
                                $('#otpCodeInput').val(res.devOtp);
                            }

                            // เริ่มเวลานับถอยหลัง 60 วินาที
                            startCountdown(60);
                        } else {
                            alertBox.removeClass('d-none alert-success').addClass('alert-danger');
                            alertIcon.removeClass('bi-check-circle-fill text-success').addClass('bi-exclamation-triangle-fill text-danger');
                            alertText.text(res.message || 'ไม่สามารถส่งรหัส OTP ได้ กรุณาลองใหม่อีกครั้ง');

                            btn.prop('disabled', false);
                            $('#btnSendOtpSpinner').addClass('d-none');
                            $('#btnSendOtpIcon').removeClass('d-none');
                            $('#btnSendOtpText').text('ขอรับ OTP');
                        }
                    },
                    error: function () {
                        alertBox.removeClass('d-none alert-success').addClass('alert-danger');
                        alertIcon.removeClass('bi-check-circle-fill text-success').addClass('bi-exclamation-triangle-fill text-danger');
                        alertText.text('เกิดข้อผิดพลาดในการเชื่อมต่อเซิร์ฟเวอร์ กรุณาลองใหม่อีกครั้ง');

                        btn.prop('disabled', false);
                        $('#btnSendOtpSpinner').addClass('d-none');
                        $('#btnSendOtpIcon').removeClass('d-none');
                        $('#btnSendOtpText').text('ขอรับ OTP');
                    }
                });
            });

            function startCountdown(seconds) {
                let current = seconds;
                $('#countdownSpan').removeClass('d-none');
                $('#countdownSeconds').text(current);
                $('#btnSendOtpSpinner').addClass('d-none');
                $('#btnSendOtpIcon').removeClass('d-none');
                $('#btnSendOtpText').text('ส่งแล้ว');

                if (countdownInterval) clearInterval(countdownInterval);

                countdownInterval = setInterval(function () {
                    current--;
                    $('#countdownSeconds').text(current);
                    if (current <= 0) {
                        clearInterval(countdownInterval);
                        $('#countdownSpan').addClass('d-none');
                        $('#btnSendOtp').prop('disabled', false);
                        $('#btnSendOtpText').text('ขอรหัสอีกครั้ง');
                    }
                }, 1000);
            }
        });
    </script>
}

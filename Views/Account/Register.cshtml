@model EasyStayHotel.Models.User
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "สมัครสมาชิก";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white text-center py-3">
                    <h4 class="m-0">ลงทะเบียนสมาชิกใหม่</h4>
                </div>
                <div class="card-body p-4">
                    <!-- แจ้งเตือนถ้าอีเมลซ้ำ -->
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger shadow-sm py-2">@ViewBag.Error</div>
                    }

                    <form asp-controller="Account" asp-action="Register" method="post">
                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-bold">ชื่อ-นามสกุล</label>
                            <input asp-for="FullName" type="text" class="form-control" placeholder="เช่น สมชาย ใจดี" required />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-bold">อีเมล (ใช้สำหรับเข้าสู่ระบบ)</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="email@example.com" required />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label fw-bold">เบอร์โทรศัพท์ (ทางเลือก)</label>
                            <input asp-for="Phone" type="text" class="form-control" placeholder="08X-XXX-XXXX" />
                        </div>
                        <div class="mb-4">
                            <label asp-for="Password" class="form-label fw-bold">ตั้งรหัสผ่าน (Password)</label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" required />
                        </div>
                        <button type="submit" class="btn btn-success w-100 mb-3">สมัครสมาชิก</button>
                        <div class="text-center mt-3">
                            <a asp-controller="Account" asp-action="Login" class="text-decoration-none text-muted">มีบัญชีอยู่แล้ว? กลับไปหน้าเข้าสู่ระบบ</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
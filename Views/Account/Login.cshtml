@model EasyStayHotel.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "เข้าสู่ระบบสมาชิก";
    string prefilledEmail = Context.Request.Query["email"].ToString();
    string emailValue = !string.IsNullOrEmpty(prefilledEmail) ? prefilledEmail : (Model?.Email ?? "");
}

<style>
    .auth-container {
        max-width: 960px;
    }
    .auth-banner-side {
        background: linear-gradient(135deg, rgba(15, 23, 42, 0.9) 0%, rgba(13, 110, 253, 0.82) 100%),
                    url('https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1000&q=80') center/cover no-repeat;
    }
    .input-group-text {
        border-color: #dee2e6;
    }
    .form-control:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);
    }
</style>

<div class="container py-5 my-md-4">
    <div class="row justify-content-center">
        <div class="col-12 auth-container">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
                <div class="row g-0">
                    
                    <!-- ฝั่งซ้าย: แบนเนอร์ภาพลักษณ์โรงแรม & สิทธิประโยชน์ -->
                    <div class="col-lg-5 auth-banner-side text-white p-4 p-md-5 d-flex flex-column justify-content-between position-relative">
                        <div>
                            <div class="d-inline-flex align-items-center gap-2 bg-white bg-opacity-20 rounded-pill px-3 py-1 mb-4">
                                <i class="bi bi-building-check text-warning"></i>
                                <span class="small fw-medium">Easy Stay Member</span>
                            </div>
                            <h3 class="fw-bold mb-3">ยินดีต้อนรับสู่ Easy Stay Hotel</h3>
                            <p class="text-white-50 small mb-4">
                                เข้าสู่ระบบเพื่อจัดการข้อมูลการจองห้องพัก รับข้อเสนอพิเศษเฉพาะสมาชิก และเพลิดเพลินกับการพักผ่อนระดับพรีเมียม
                            </p>
                        </div>

                        <div class="my-3">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="bg-white bg-opacity-20 rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                    <i class="bi bi-gift-fill text-warning fs-5"></i>
                                </div>
                                <div class="small">
                                    <div class="fw-bold">ส่วนลดเดือนเกิด 10%</div>
                                    <div class="text-white-50">รับสิทธิ์อัตโนมัติในเดือนเกิดของคุณ</div>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="bg-white bg-opacity-20 rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                    <i class="bi bi-calendar2-check-fill text-info fs-5"></i>
                                </div>
                                <div class="small">
                                    <div class="fw-bold">จัดการการจองสะดวก 24 ชม.</div>
                                    <div class="text-white-50">ตรวจสอบสถานะห้องพักและสลิปการโอน</div>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-white bg-opacity-20 rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                    <i class="bi bi-shield-check text-success fs-5"></i>
                                </div>
                                <div class="small">
                                    <div class="fw-bold">ความปลอดภัยมาตรฐาน</div>
                                    <div class="text-white-50">ระบบยืนยันตัวตนด้วยรหัส OTP ทางอีเมล</div>
                                </div>
                            </div>
                        </div>

                        <div class="pt-4 border-top border-white border-opacity-25 small text-white-50">
                            &copy; @DateTime.Now.Year Easy Stay Hotel & Resort
                        </div>
                    </div>

                    <!-- ฝั่งขวา: ฟอร์มเข้าสู่ระบบ -->
                    <div class="col-lg-7 p-4 p-md-5 d-flex flex-column justify-content-center">
                        <div class="mb-4">
                            <span class="text-primary fw-bold small text-uppercase letter-spacing-1">Member Portal</span>
                            <h3 class="fw-bold text-dark mt-1 mb-1">เข้าสู่ระบบสมาชิก</h3>
                            <p class="text-muted small">กรอกอีเมลและรหัสผ่านเพื่อเข้าสู่บัญชีผู้ใช้งานของคุณ</p>
                        </div>

                        <!-- แจ้งเตือนสำเร็จเมื่อสมัครสมาชิกเสร็จ -->
                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 py-3 mb-4" role="alert">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                                    <span class="small fw-medium">@TempData["SuccessMessage"]</span>
                                </div>
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        <!-- แจ้งเตือนเมื่อเกิดข้อผิดพลาด / ปฏิเสธการเข้าถึง -->
                        @if (TempData["ErrorMessage"] != null)
                        {
                            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 py-3 mb-4" role="alert">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-shield-exclamation fs-5 text-danger"></i>
                                    <span class="small fw-medium">@TempData["ErrorMessage"]</span>
                                </div>
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 py-3 mb-4" role="alert">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
                                    <span class="small fw-medium">@ViewBag.Error</span>
                                </div>
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        <form asp-controller="Account" asp-action="Login" method="post" asp-route-returnUrl="@ViewBag.ReturnUrl">
                            <div class="mb-3">
                                <label asp-for="Email" class="form-label small fw-bold text-dark">อีเมลที่ลงทะเบียน</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted">
                                        <i class="bi bi-envelope-at"></i>
                                    </span>
                                    <input asp-for="Email" type="email" class="form-control border-start-0 ps-0"
                                           placeholder="example@easystay.com" value="@emailValue" required autofocus />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label asp-for="Password" class="form-label small fw-bold text-dark mb-0">รหัสผ่าน</label>
                                </div>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted">
                                        <i class="bi bi-lock"></i>
                                    </span>
                                    <input asp-for="Password" type="password" id="loginPasswordInput"
                                           class="form-control border-start-0 border-end-0 ps-0"
                                           placeholder="ระบุรหัสผ่านของคุณ" required />
                                    <button class="btn btn-outline-secondary border-start-0" type="button" id="togglePasswordBtn">
                                        <i class="bi bi-eye" id="togglePasswordIcon"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" asp-for="RememberMe" id="rememberMeCheck">
                                    <label class="form-check-label small text-muted" for="rememberMeCheck">
                                        จดจำการเข้าสู่ระบบ
                                    </label>
                                </div>
                                <a asp-controller="Account" asp-action="ForgotPassword" class="small text-decoration-none text-primary fw-medium">
                                    ลืมรหัสผ่าน?
                                </a>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 py-3 fw-bold rounded-3 shadow-sm mb-4">
                                <i class="bi bi-box-arrow-in-right me-1"></i> เข้าสู่ระบบ (Sign In)
                            </button>

                            <div class="text-center pt-3 border-top">
                                <span class="text-muted small">ยังไม่มีบัญชีสมาชิกใช่หรือไม่?</span>
                                <a asp-controller="Account" asp-action="Register" class="text-decoration-none fw-bold text-primary ms-1 small">
                                    สมัครสมาชิกใหม่ <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // ปุ่มแสดง/ซ่อนรหัสผ่าน
            $('#togglePasswordBtn').on('click', function () {
                const passwordInput = $('#loginPasswordInput');
                const icon = $('#togglePasswordIcon');
                
                if (passwordInput.attr('type') === 'password') {
                    passwordInput.attr('type', 'text');
                    icon.removeClass('bi-eye').addClass('bi-eye-slash');
                } else {
                    passwordInput.attr('type', 'password');
                    icon.removeClass('bi-eye-slash').addClass('bi-eye');
                }
            });
        });
    </script>
}

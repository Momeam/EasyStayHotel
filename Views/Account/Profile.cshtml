@model EasyStayHotel.Models.ViewModels.UserProfileViewModel
@{
    ViewData["Title"] = "โปรไฟล์และข้อมูลส่วนตัว";
    string firstLetter = !string.IsNullOrWhiteSpace(Model.FullName) ? Model.FullName.Substring(0, 1).ToUpper() : "U";
}

<style>
    .profile-card {
        border-radius: 1.25rem;
        border: 1px solid rgba(0, 0, 0, 0.08);
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
    }
    .avatar-circle {
        width: 88px;
        height: 88px;
        border-radius: 50%;
        background: linear-gradient(135deg, #0d6efd 0%, #0b5ed7 100%);
        color: #fff;
        font-size: 2.5rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 6px 16px rgba(13, 110, 253, 0.3);
    }
    .badge-role {
        font-size: 0.8rem;
        padding: 0.35rem 0.8rem;
        border-radius: 2rem;
    }
    .nav-pills-custom .nav-link {
        color: #495057;
        font-weight: 500;
        border-radius: 0.75rem;
        padding: 0.75rem 1.25rem;
        transition: all 0.2s ease;
    }
    .nav-pills-custom .nav-link.active {
        background-color: #0d6efd;
        color: #fff;
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.25);
    }
    .form-control:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);
    }
    .form-label {
        font-weight: 600;
        font-size: 0.9rem;
        color: #334155;
    }
</style>

<div class="container py-5">
    <!-- Breadcrumb & Header -->
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">หน้าแรก</a></li>
                    <li class="breadcrumb-item active" aria-current="page">โปรไฟล์ผู้ใช้งาน</li>
                </ol>
            </nav>
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <h2 class="fw-bold text-dark mb-1">
                        <i class="bi bi-person-gear text-primary me-2"></i>จัดการข้อมูลส่วนตัว
                    </h2>
                    <p class="text-muted mb-0 small">แก้ไขข้อมูลส่วนบุคคล เบอร์โทรศัพท์ และตั้งรหัสผ่านใหม่เพื่อความปลอดภัย</p>
                </div>
                <a asp-controller="Booking" asp-action="MyBookings" class="btn btn-outline-primary rounded-pill px-4 btn-sm">
                    <i class="bi bi-journal-bookmark me-1"></i> ดูประวัติการจองของฉัน
                </a>
            </div>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4 py-3 mb-4" role="alert">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-check-circle-fill fs-4 text-success"></i>
                <div>
                    <div class="fw-bold">ดำเนินการสำเร็จ</div>
                    <div class="small">@TempData["SuccessMessage"]</div>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-4 py-3 mb-4" role="alert">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-exclamation-triangle-fill fs-4 text-danger"></i>
                <div>
                    <div class="fw-bold">เกิดข้อผิดพลาดในการบันทึกข้อมูล</div>
                    <ul class="mb-0 small ps-3">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- ฝั่งซ้าย: ข้อมูลสรุปโปรไฟล์ & บัญชี -->
        <div class="col-lg-4">
            <div class="card profile-card bg-white p-4 text-center">
                <div class="avatar-circle mx-auto mb-3">
                    @firstLetter
                </div>
                <h4 class="fw-bold text-dark mb-1">@Model.FullName</h4>
                <p class="text-muted small mb-2"><i class="bi bi-envelope me-1"></i>@Model.Email</p>

                <div class="d-flex justify-content-center gap-2 mb-4">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle badge-role">
                        <i class="bi bi-shield-check me-1"></i>สิทธิ์: @(Model.Role ?? "Customer")
                    </span>
                </div>

                <div class="list-group list-group-flush text-start border-top pt-3 small">
                    <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-2 border-0">
                        <span class="text-muted"><i class="bi bi-telephone me-2"></i>เบอร์ติดต่อ</span>
                        <span class="fw-medium text-dark">@(string.IsNullOrEmpty(Model.Phone) ? "ยังไม่ระบุ" : Model.Phone)</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-2 border-0">
                        <span class="text-muted"><i class="bi bi-calendar3 me-2"></i>วันเกิด</span>
                        <span class="fw-medium text-dark">@(Model.DateOfBirth?.ToString("dd/MM/yyyy") ?? "ยังไม่ระบุ")</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-2 border-0">
                        <span class="text-muted"><i class="bi bi-card-heading me-2"></i>เลขประจำตัว/Passport</span>
                        <span class="fw-medium text-dark">@(string.IsNullOrEmpty(Model.IdCardOrPassport) ? "ยังไม่ระบุ" : Model.IdCardOrPassport)</span>
                    </div>
                </div>

                <div class="bg-light rounded-3 p-3 mt-4 text-start small border">
                    <div class="fw-bold text-dark mb-1">
                        <i class="bi bi-info-circle text-primary me-1"></i> สิทธิประโยชน์สมาชิก
                    </div>
                    <p class="text-muted mb-0" style="font-size: 0.8rem;">
                        สมาชิก Easy Stay รับสิทธิ์ส่วนลดพิเศษ 10% ในเดือนเกิดของคุณอัตโนมัติ และสะสมสถิติการเข้าพักในเครือทุกสาขา
                    </p>
                </div>
            </div>
        </div>

        <!-- ฝั่งขวา: ฟอร์มแก้ไขข้อมูลส่วนตัว & เปลี่ยนรหัสผ่าน -->
        <div class="col-lg-8">
            <div class="card profile-card bg-white p-4 p-md-5">
                <form asp-controller="Account" asp-action="Profile" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="UserId" />

                    <!-- แท็บเลือกส่วนข้อมูลทั่วไป หรือ ความปลอดภัย -->
                    <ul class="nav nav-pills nav-pills-custom mb-4 bg-light p-1 rounded-4" id="profileTabs" role="tablist">
                        <li class="nav-item flex-fill text-center" role="presentation">
                            <button class="nav-link active w-100 py-2" id="info-tab" data-bs-toggle="pill" data-bs-target="#tab-info" type="button" role="tab">
                                <i class="bi bi-person-lines-fill me-1"></i> ข้อมูลส่วนบุคคล
                            </button>
                        </li>
                        <li class="nav-item flex-fill text-center" role="presentation">
                            <button class="nav-link w-100 py-2" id="security-tab" data-bs-toggle="pill" data-bs-target="#tab-security" type="button" role="tab">
                                <i class="bi bi-shield-lock-fill me-1"></i> ความปลอดภัย & เปลี่ยนรหัสผ่าน
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content" id="profileTabContent">
                        
                        <!-- TAB 1: ข้อมูลส่วนบุคคล -->
                        <div class="tab-pane fade show active" id="tab-info" role="tabpanel">
                            <div class="row g-3">
                                <div class="col-12">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <h5 class="fw-bold text-dark mb-0">ข้อมูลประจำตัวผู้ใช้งาน</h5>
                                        <span class="badge bg-light text-muted border">ID: #@Model.UserId</span>
                                    </div>
                                    <hr class="mt-1 mb-3">
                                </div>

                                <div class="col-md-12">
                                    <label asp-for="Email" class="form-label">อีเมลประจำบัญชี (ไม่สามารถเปลี่ยนแปลงได้)</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope-fill"></i></span>
                                        <input asp-for="Email" class="form-control bg-light text-muted" readonly />
                                    </div>
                                    <small class="text-muted">อีเมลนี้ใช้สำหรับการเข้าสู่ระบบและการรับใบเสร็จยืนยันการจอง</small>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="FullName" class="form-label">ชื่อ - นามสกุล <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-muted"><i class="bi bi-person"></i></span>
                                        <input asp-for="FullName" class="form-control" placeholder="ระบุชื่อและนามสกุล" required />
                                    </div>
                                    <span asp-validation-for="FullName" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Phone" class="form-label">เบอร์โทรศัพท์ติดต่อ <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-muted"><i class="bi bi-telephone"></i></span>
                                        <input asp-for="Phone" class="form-control" placeholder="0812345678" required />
                                    </div>
                                    <span asp-validation-for="Phone" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="DateOfBirth" class="form-label">วันเดือนปีเกิด</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-muted"><i class="bi bi-calendar-event"></i></span>
                                        <input asp-for="DateOfBirth" type="date" class="form-control" />
                                    </div>
                                    <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="IdCardOrPassport" class="form-label">เลขบัตรประชาชน / หนังสือเดินทาง</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-muted"><i class="bi bi-card-text"></i></span>
                                        <input asp-for="IdCardOrPassport" class="form-control" placeholder="ระบุเลขบัตรประชาชน 13 หลัก หรือ Passport" />
                                    </div>
                                    <span asp-validation-for="IdCardOrPassport" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- TAB 2: ความปลอดภัย & เปลี่ยนรหัสผ่าน -->
                        <div class="tab-pane fade" id="tab-security" role="tabpanel">
                            <div class="mb-3">
                                <h5 class="fw-bold text-dark mb-1">เปลี่ยนรหัสผ่านเข้าสู่ระบบ</h5>
                                <p class="text-muted small">หากไม่ต้องการเปลี่ยนรหัสผ่าน ให้เว้นว่างช่องเหล่านี้ไว้</p>
                                <hr class="mt-1 mb-4">
                            </div>

                            <div class="row g-3">
                                <div class="col-12">
                                    <label asp-for="CurrentPassword" class="form-label">รหัสผ่านปัจจุบัน</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-muted"><i class="bi bi-key"></i></span>
                                        <input asp-for="CurrentPassword" type="password" id="inputCurrentPass" class="form-control border-end-0" placeholder="ระบุรหัสผ่านปัจจุบันของคุณ" />
                                        <button class="btn btn-outline-secondary border-start-0" type="button" onclick="togglePassVisibility('inputCurrentPass', this)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="NewPassword" class="form-label">รหัสผ่านใหม่</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-muted"><i class="bi bi-lock"></i></span>
                                        <input asp-for="NewPassword" type="password" id="inputNewPass" class="form-control border-end-0" placeholder="อย่างน้อย 6 ตัวอักษร" />
                                        <button class="btn btn-outline-secondary border-start-0" type="button" onclick="togglePassVisibility('inputNewPass', this)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="ConfirmNewPassword" class="form-label">ยืนยันรหัสผ่านใหม่</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-muted"><i class="bi bi-lock-fill"></i></span>
                                        <input asp-for="ConfirmNewPassword" type="password" id="inputConfirmPass" class="form-control border-end-0" placeholder="กรอกรหัสผ่านใหม่อีกครั้ง" />
                                        <button class="btn btn-outline-secondary border-start-0" type="button" onclick="togglePassVisibility('inputConfirmPass', this)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                                </div>

                                <div class="col-12 mt-3">
                                    <div class="alert alert-warning border-0 rounded-3 p-3 small mb-0">
                                        <div class="fw-bold mb-1"><i class="bi bi-shield-exclamation me-1"></i> คำแนะนำด้านความปลอดภัย:</div>
                                        <ul class="mb-0 ps-3">
                                            <li>รหัสผ่านควรมีความยาวอย่างน้อย 6 ตัวอักษรขึ้นไป</li>
                                            <li>ควรใช้ตัวอักษรพิมพ์เล็ก พิมพ์ใหญ่ และตัวเลขผสมกัน</li>
                                            <li>หากคุณลืมรหัสผ่านปัจจุบัน สามารถใช้ฟังก์ชัน "ลืมรหัสผ่าน" ในหน้าเข้าสู่ระบบเพื่อยืนยัน OTP ทางอีเมล</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- ปุ่มบันทึกข้อมูล -->
                    <div class="d-flex justify-content-end gap-3 mt-4 pt-3 border-top">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-light border rounded-pill px-4">
                            ยกเลิก
                        </a>
                        <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm">
                            <i class="bi bi-save me-1"></i> บันทึกข้อมูล
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePassVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }
    </script>
}

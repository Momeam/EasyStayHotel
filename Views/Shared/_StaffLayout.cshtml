@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var userFullName = HttpContextAccessor.HttpContext?.Session.GetString("FullName") ?? "ไม่พบชื่อพนักงาน";
    var userRole = HttpContextAccessor.HttpContext?.Session.GetString("Role") ?? "พนักงาน";
    var userBranch = HttpContextAccessor.HttpContext?.Session.GetString("Branch") ?? "Bangkok";
    var userBranchTh = EasyStayHotel.Services.RoomPreviewHelper.GetBranchNameTh(userBranch);
    var displayName = userFullName?.StartsWith("คุณ") == true ? userFullName : $"คุณ {userFullName}";

    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Easy Stay Staff Console</title>
    <link rel="icon" type="image/png" href="~/images/logo.png" />

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">

    <!-- นำเข้า Bootstrap Icons และ Google Fonts (Kanit) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- สไตล์ CSS สำหรับ ธีม Staff - รองรับ Laptop และ PC -->
    <style>
        body {
            font-family: 'Kanit', sans-serif;
            background-color: #f8fafc;
            overflow-x: clip;
        }

        /* แถบเมนูด้านข้าง (Sidebar) ล็อกติดขอบบนเสมอเมื่อเลื่อนหน้าจอลง */
        .sidebar {
            background-color: #0f172a; 
            width: 230px;
            height: 100vh;
            max-height: 100vh;
            border-right: 1px solid #1e293b;
            position: sticky;
            top: 0;
            align-self: flex-start;
            flex-shrink: 0;
            overflow-y: auto;
            overflow-x: hidden;
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            z-index: 1030;
        }

        /* Sidebar เมื่อย่อ (Collapsed state สำหรับจอแท็บเล็ต/โน้ตบุ๊ก) */
        @@media (min-width: 768px) {
            .sidebar.collapsed {
                width: 72px;
            }
            .sidebar.collapsed .sidebar-text,
            .sidebar.collapsed .user-profile-box,
            .sidebar.collapsed .brand-text {
                display: none !important;
            }
            .sidebar.collapsed .sidebar-link {
                justify-content: center;
                padding: 12px 0;
            }
            .sidebar.collapsed .sidebar-link i {
                margin-right: 0 !important;
                font-size: 1.3rem;
            }
            .sidebar.collapsed .brand-icon-box {
                margin-right: 0 !important;
            }
        }

        /* Sidebar สำหรับหน้าจอมือถือ (< 768px): ซ่อนออกนอกจอ 100% และสไลด์ออกมาเมื่อกดปุ่มเมนู */
        .sidebar-backdrop {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.5);
            backdrop-filter: blur(2px);
            z-index: 1035;
        }
        @@media (max-width: 767.98px) {
            .sidebar {
                position: fixed;
                left: 0;
                top: 0;
                bottom: 0;
                width: 250px !important;
                z-index: 1040;
                transform: translateX(0);
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
            }
            .sidebar.collapsed {
                transform: translateX(-100%);
            }
            .sidebar:not(.collapsed) ~ .sidebar-backdrop {
                display: block;
            }
        }

        /* กล่องข้อมูลผู้ใช้งานใน Sidebar */
        .user-profile-box {
            background-color: #1e293b;
            border-radius: 10px;
            padding: 12px;
            margin-bottom: 12px;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        /* เมนูลิงก์ */
        .sidebar-link {
            color: #94a3b8;
            text-decoration: none;
            padding: 9px 12px;
            border-radius: 8px;
            margin-bottom: 3px;
            display: flex;
            align-items: center;
            font-weight: 400;
            font-size: 0.92rem;
            transition: all 0.18s ease;
        }

        .sidebar-link i {
            margin-right: 10px;
            font-size: 1.05rem;
            flex-shrink: 0;
        }

        .sidebar-link:hover {
            background-color: rgba(255, 255, 255, 0.06);
            color: #ffffff;
        }

        .sidebar-link.active {
            background-color: #0d6efd;
            color: #ffffff;
            font-weight: 500;
            box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
        }

        /* ปุ่มออกจากระบบ */
        .logout-link {
            color: #f87171;
            text-decoration: none;
            padding: 9px 12px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            font-size: 0.9rem;
            transition: all 0.18s ease;
        }

        .logout-link:hover {
            background-color: rgba(239, 68, 68, 0.12);
            color: #ef4444;
        }

        /* Dark scrollbar สำหรับ sidebar */
        .sidebar::-webkit-scrollbar {
            width: 4px;
        }
        .sidebar::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 4px;
        }

        /* Main Content Container */
        .main-wrapper {
            flex-grow: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
            background-color: #f8fafc;
        }

        /* Top Bar ด้านบนของ Main Content */
        .staff-topbar {
            background-color: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            padding: 0.5rem 1.25rem;
            position: sticky;
            top: 0;
            z-index: 1020;
            box-shadow: 0 1px 4px rgba(0, 0, 0, 0.03);
        }
    </style>
</head>
<body>
    <div class="d-flex" style="min-height: 100vh;">

        <!-- Sidebar ด้านซ้าย -->
        <aside class="sidebar text-white d-flex flex-column p-3" id="staffSidebar">

            <!-- โลโก้และชื่อระบบ -->
            <a asp-controller="Staff" asp-action="DailyOverview" class="d-flex align-items-center mb-3 mt-1 px-1 text-decoration-none">
                <div class="brand-logo-box me-2 brand-icon-box shadow-sm">
                    <img src="~/images/logo.png" alt="Easy Stay Hotel" />
                </div>
                <div class="brand-text">
                    <h6 class="m-0 fw-bold text-white lh-1">Easy Stay</h6>
                    <small class="text-info" style="font-size: 0.7rem; letter-spacing: 0.8px;">STAFF CONSOLE</small>
                </div>
            </a>

            <!-- กล่องข้อมูลพนักงาน ดึงจาก Session -->
            <div class="user-profile-box">
                <div class="fw-bold text-white small mb-1 text-truncate" title="@displayName">
                    @displayName
                </div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <small style="color: #94a3b8; font-size: 0.75rem;">สิทธิ์: @userRole</small>
                    <span class="badge bg-success rounded-pill" style="font-size: 0.6rem;"><i class="bi bi-circle-fill me-1"></i>ออนไลน์</span>
                </div>

                @if (userRole == "Staff")
                {
                    <div class="pt-2 border-top border-secondary border-opacity-25">
                        <span class="badge bg-primary bg-opacity-25 text-info border border-info border-opacity-25 rounded-pill px-2 py-1 small w-100 text-truncate text-start d-flex align-items-center gap-1">
                            <i class="bi bi-geo-alt-fill text-warning"></i>
                            <span>สาขา: @(userBranchTh)</span>
                        </span>
                        <div class="text-white-50 mt-1 ps-1" style="font-size: 0.65rem;">(จำกัดสิทธิ์เฉพาะสาขานี้)</div>
                    </div>
                }
                else if (userRole == "Admin" || userRole == "SuperAdmin")
                {
                    <div class="pt-2 border-top border-secondary border-opacity-25">
                        <div class="dropdown">
                            <button class="btn btn-dark btn-sm dropdown-toggle w-100 text-warning text-start d-flex justify-content-between align-items-center py-1 px-2 border border-secondary" type="button" data-bs-toggle="dropdown" style="font-size: 0.75rem;">
                                <span><i class="bi bi-geo-alt-fill me-1"></i>@(userBranchTh)</span>
                            </button>
                            <ul class="dropdown-menu shadow">
                                <li><a class="dropdown-item small" href="?branch=Bangkok">กรุงเทพมหานคร</a></li>
                                <li><a class="dropdown-item small" href="?branch=Chonburi">ชลบุรี (พัทยา)</a></li>
                                <li><a class="dropdown-item small" href="?branch=Phuket">ภูเก็ต</a></li>
                            </ul>
                        </div>
                    </div>
                }
            </div>

            <!-- เมนูนำทาง (Navigation) พร้อมระบบ Active Menu -->
            <ul class="nav flex-column flex-grow-1">
                <li class="nav-item">
                    <a class="sidebar-link @(currentAction == "DailyOverview" ? "active" : "")" 
                       asp-controller="Staff" asp-action="DailyOverview" title="ภาพรวมรายวัน">
                        <i class="bi bi-calendar2-day-fill"></i>
                        <span class="sidebar-text">ภาพรวมรายวัน (Overview)</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="sidebar-link @(currentAction == "CheckInDesk" ? "active" : "")" 
                       asp-controller="Staff" asp-action="CheckInDesk" title="เช็คอินออนไลน์">
                        <i class="bi bi-key-fill"></i>
                        <span class="sidebar-text">เช็คอินออนไลน์ (Check-in)</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="sidebar-link @(currentAction == "WalkinBooking" ? "active" : "")" 
                       asp-controller="Staff" asp-action="WalkinBooking" title="จองแบบ Walk-in">
                        <i class="bi bi-person-plus-fill"></i>
                        <span class="sidebar-text">จองแบบ Walk-in</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="sidebar-link @(currentAction == "BookingList" ? "active" : "")" 
                       asp-controller="Staff" asp-action="BookingList" title="รายชื่อผู้เข้าพัก">
                        <i class="bi bi-card-list"></i>
                        <span class="sidebar-text">รายชื่อผู้เข้าพัก (Bookings)</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="sidebar-link @(currentAction == "Index" ? "active" : "")" 
                       asp-controller="Staff" asp-action="Index" title="จัดการสถานะห้อง">
                        <i class="bi bi-door-open-fill"></i>
                        <span class="sidebar-text">จัดการสถานะห้อง (Rooms)</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="sidebar-link @(currentAction == "AccountingFeedback" ? "active" : "")" 
                       asp-controller="Staff" asp-action="AccountingFeedback" title="ส่ง Feedback ถึงฝ่ายบัญชี">
                        <i class="bi bi-chat-left-text-fill"></i>
                        <span class="sidebar-text">ส่ง Feedback ถึงบัญชี</span>
                    </a>
                </li>

                <!-- ลิงก์พิเศษสำหรับผู้ดูแลระบบ (Admin) หรือกลับหน้าแรก -->
                @if (userRole == "Admin" || userRole == "SuperAdmin")
                {
                    <li class="nav-item mt-2 pt-2 border-top border-secondary border-opacity-25">
                        <a class="sidebar-link text-warning fw-bold" asp-controller="Admin" asp-action="Dashboard" title="ระบบแอดมิน">
                            <i class="bi bi-speedometer2 text-warning"></i>
                            <span class="sidebar-text">ระบบแอดมิน (Admin)</span>
                        </a>
                    </li>
                }
                <li class="nav-item mt-1">
                    <a class="sidebar-link text-white-50" asp-controller="Home" asp-action="Index" title="หน้าแรกเว็บไซต์">
                        <i class="bi bi-house-door-fill"></i>
                        <span class="sidebar-text">หน้าแรกเว็บไซต์</span>
                    </a>
                </li>
            </ul>

            <!-- ปุ่มออกจากระบบ -->
            <div class="mt-auto pt-2 border-top border-secondary border-opacity-25">
                <a asp-controller="Account" asp-action="Logout" class="logout-link fw-medium" title="ออกจากระบบ">
                    <i class="bi bi-box-arrow-right me-2"></i>
                    <span class="sidebar-text">ออกจากระบบ (Logout)</span>
                </a>
            </div>
        </aside>

        <!-- ฉากหลังสีเข้มเมื่อเปิดเมนูบนมือถือ -->
        <div class="sidebar-backdrop" id="staffSidebarBackdrop" onclick="$('#staffSidebar').addClass('collapsed');"></div>

        <!-- Main Content Area ด้านขวา -->
        <div class="main-wrapper">

            <!-- Top Bar สำหรับ Laptop/PC -->
            <header class="staff-topbar d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-3">
                    <button type="button" class="btn btn-light border btn-sm rounded-pill px-3 shadow-none text-muted d-flex align-items-center gap-1" id="sidebarToggleBtn" title="ย่อ/ขยาย เมนูด้านข้างเพื่อเพิ่มพื้นที่หน้าจอ">
                        <i class="bi bi-layout-sidebar-inset"></i>
                        <span class="small d-none d-md-inline" id="sidebarToggleText">ย่อเมนู</span>
                    </button>
                    <div class="d-none d-sm-block">
                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-3 py-1 rounded-pill small">
                            <i class="bi bi-geo-alt-fill me-1"></i>สาขา @(userBranchTh)
                        </span>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <div class="text-muted small d-none d-lg-flex align-items-center gap-2">
                        <i class="bi bi-clock text-primary"></i>
                        <span id="liveClockDisplay">@DateTime.Now.ToString("HH:mm:ss") น.</span>
                    </div>
                    <div class="vr d-none d-lg-block my-1 text-muted opacity-25"></div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-dark small fw-medium">@displayName</span>
                        <span class="badge bg-light text-muted border rounded-pill">@userRole</span>
                    </div>
                </div>
            </header>

            <!-- Alerts -->
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="px-3 px-md-4 pt-3 pb-0">
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-4 mb-0" role="alert">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-shield-exclamation fs-5 text-danger"></i>
                            <span class="small fw-medium">@TempData["ErrorMessage"]</span>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                </div>
            }
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="px-3 px-md-4 pt-3 pb-0">
                    <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-4 mb-0" role="alert">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                            <span class="small fw-medium">@TempData["SuccessMessage"]</span>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                </div>
            }

            <!-- Render Body -->
            <div class="px-3 px-md-4 py-2 py-md-3 flex-grow-1">
                @RenderBody()
            </div>

            <!-- Footer -->
            <footer class="py-2 px-4 border-top bg-white text-muted small text-center text-md-between d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 mt-auto">
                <div>&copy; @DateTime.Now.Year Easy Stay Hotel & Resort - Staff Console</div>
                <div>ระบบปฏิบัติการเคาน์เตอร์ต้อนรับ สาขา @(userBranchTh)</div>
            </footer>

        </div>

    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#sidebarToggleBtn').on('click', function () {
                const sidebar = $('#staffSidebar');
                sidebar.toggleClass('collapsed');
                if (sidebar.hasClass('collapsed')) {
                    $('#sidebarToggleText').text('ขยายเมนู');
                    localStorage.setItem('staff_sidebar_collapsed', 'true');
                } else {
                    $('#sidebarToggleText').text('ย่อเมนู');
                    localStorage.setItem('staff_sidebar_collapsed', 'false');
                }
            });

            function syncStaffSidebarByViewport() {
                if (window.innerWidth < 1100) {
                    $('#staffSidebar').addClass('collapsed');
                    $('#sidebarToggleText').text('ขยายเมนู');
                } else if (localStorage.getItem('staff_sidebar_collapsed') === 'true') {
                    $('#staffSidebar').addClass('collapsed');
                    $('#sidebarToggleText').text('ขยายเมนู');
                } else {
                    $('#staffSidebar').removeClass('collapsed');
                    $('#sidebarToggleText').text('ย่อเมนู');
                }
            }
            syncStaffSidebarByViewport();
            $(window).on('resize', syncStaffSidebarByViewport);

            setInterval(function () {
                const now = new Date();
                const hours = String(now.getHours()).padStart(2, '0');
                const mins = String(now.getMinutes()).padStart(2, '0');
                const secs = String(now.getSeconds()).padStart(2, '0');
                $('#liveClockDisplay').text(hours + ':' + mins + ':' + secs + ' น.');
            }, 1000);
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

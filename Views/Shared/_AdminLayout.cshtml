<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Easy Stay Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>

<body style="background-color: #f4f6f9; font-family: 'Kanit', sans-serif;">
    <div class="d-flex" style="min-height: 100vh;">
        
        <!-- Sidebar สีเข้ม -->
        <div class="bg-dark text-white p-3 d-flex flex-column" style="width: 250px;">
            <div class="text-center mb-4 mt-2">
                <h3 class="fw-bold text-info mb-0">Easy Stay</h3>
                <p class="text-muted small">ADMIN CONSOLE</p>
            </div>
            <hr class="border-secondary my-2" />
            <ul class="nav nav-pills flex-column mb-auto">
                <li class="nav-item mb-2">
                    <a class="nav-link text-white" asp-controller="Admin" asp-action="Dashboard">
                        <i class="bi bi-speedometer2 me-2"></i> ภาพรวมระบบ (Dashboard)
                    </a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link text-warning fw-bold" asp-controller="Admin" asp-action="UserManagement">
                        <i class="bi bi-people-fill me-2"></i> จัดการผู้ใช้งาน (Users)
                    </a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link text-white" asp-controller="Admin" asp-action="RoomManagement">
                        <i class="bi bi-door-open-fill me-2"></i> จัดการห้องพัก (Rooms)
                    </a>
                </li>
                <li class="nav-item mt-2">
                    <a class="nav-link text-white bg-success rounded shadow-sm" asp-controller="Admin" asp-action="CreateRoom">
                        <i class="bi bi-plus-circle me-1"></i> สร้างห้องพักใหม่
                    </a>
                </li>
                <li class="nav-item mt-4 pt-3 border-top border-secondary">
                    <a class="nav-link text-info fw-medium" asp-controller="Staff" asp-action="BookingList">
                        <i class="bi bi-briefcase-fill me-2"></i> ระบบพนักงาน (Staff)
                    </a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link text-white-50" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-door-fill me-2"></i> หน้าแรกเว็บไซต์
                    </a>
                </li>
            </ul>
        </div>

        <!-- Content Area -->
        <div class="flex-grow-1">
            <!-- Navbar ด้านบน -->
            <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm mb-4 px-4">
                <div class="container-fluid">
                    <span class="navbar-brand fw-bold text-primary">ระบบการจัดการระดับผู้บริหาร (Admin Panel)</span>
                    <div class="d-flex align-items-center gap-3">
                        <span class="fw-bold text-dark"><i class="bi bi-person-badge text-warning me-1"></i> ผู้ดูแลระบบ (Admin)</span>
                        <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                            <i class="bi bi-box-arrow-right me-1"></i> ออกจากระบบ
                        </a>
                    </div>
                </div>
            </nav>

            <!-- พื้นที่แสดงเนื้อหาหลัก -->
            <div class="container-fluid px-4 pb-5">
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3 mb-4" role="alert">
                        <i class="bi bi-shield-exclamation me-2 fs-5"></i> @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3 mb-4" role="alert">
                        <i class="bi bi-check-circle-fill me-2 fs-5 text-success"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>

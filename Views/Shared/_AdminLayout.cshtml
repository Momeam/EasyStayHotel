<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Easy Stay Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        .admin-sidebar {
            width: 250px;
            height: 100vh;
            max-height: 100vh;
            position: sticky;
            top: 0;
            overflow-y: auto;
            overflow-x: hidden;
            flex-shrink: 0;
            background-color: #0f172a;
        }
        .admin-sidebar .nav-link {
            padding: 10px 14px;
            border-radius: 8px;
            margin-bottom: 4px;
            color: #94a3b8;
            font-size: 0.92rem;
            transition: all 0.2s ease;
        }
        .admin-sidebar .nav-link:hover {
            color: #ffffff;
            background-color: rgba(255, 255, 255, 0.08);
        }
        .admin-sidebar .nav-link.active {
            background-color: #0d6efd;
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
        }
    </style>
</head>

<body style="background-color: #f8fafc; font-family: 'Kanit', sans-serif;">
    <div class="d-flex" style="min-height: 100vh;">
        
        <!-- Sidebar สีเข้ม -->
        <aside class="admin-sidebar text-white p-3 d-flex flex-column border-end border-secondary border-opacity-25">
            <div class="d-flex align-items-center mb-3 mt-1 px-1">
                <div class="bg-warning text-dark rounded-3 p-2 me-2 d-flex align-items-center justify-content-center shadow-sm" style="width: 36px; height: 36px;">
                    <i class="bi bi-shield-lock-fill fs-5"></i>
                </div>
                <div>
                    <h6 class="m-0 fw-bold text-white lh-1">Easy Stay</h6>
                    <small class="text-warning" style="font-size: 0.7rem; letter-spacing: 0.8px;">ADMIN CONSOLE</small>
                </div>
            </div>

            <hr class="border-secondary border-opacity-25 my-2" />

            <ul class="nav flex-column mb-auto">
                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Admin" asp-action="Dashboard">
                        <i class="bi bi-speedometer2 me-2 text-warning"></i> ภาพรวมระบบ (Dashboard)
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-warning fw-bold" asp-controller="Admin" asp-action="UserManagement">
                        <i class="bi bi-people-fill me-2"></i> จัดการผู้ใช้งาน (Users)
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Admin" asp-action="RoomManagement">
                        <i class="bi bi-door-open-fill me-2 text-info"></i> จัดการห้องพัก (Rooms)
                    </a>
                </li>
                <li class="nav-item mt-2">
                    <a class="nav-link text-white bg-success rounded-pill shadow-sm py-2 px-3 fw-bold text-center" asp-controller="Admin" asp-action="CreateRoom">
                        <i class="bi bi-plus-circle me-1"></i> สร้างห้องพักใหม่
                    </a>
                </li>
                <li class="nav-item mt-4 pt-3 border-top border-secondary border-opacity-25">
                    <small class="text-white-50 px-2 fw-bold" style="font-size: 0.72rem; letter-spacing: 0.5px;">ระบบงานแต่ละฝ่าย</small>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-info fw-medium" asp-controller="Staff" asp-action="BookingList">
                        <i class="bi bi-briefcase-fill me-2"></i> ระบบพนักงาน (Staff)
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-warning fw-medium" asp-controller="Accounting" asp-action="RevenueReport">
                        <i class="bi bi-calculator-fill me-2"></i> ระบบบัญชีและการเงิน
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white fw-medium" style="color: #2dd4bf !important;" asp-controller="Housekeeper" asp-action="Dashboard">
                        <i class="bi bi-stars me-2"></i> แดชบอร์ดแม่บ้าน
                    </a>
                </li>
                <li class="nav-item mt-2 pt-2 border-top border-secondary border-opacity-25">
                    <a class="nav-link text-white-50" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-door-fill me-2"></i> หน้าแรกเว็บไซต์
                    </a>
                </li>
            </ul>

            <div class="mt-auto pt-3 border-top border-secondary border-opacity-25">
                <a asp-controller="Account" asp-action="Logout" class="nav-link text-danger py-2">
                    <i class="bi bi-box-arrow-right me-2"></i> ออกจากระบบ (Logout)
                </a>
            </div>
        </aside>

        <!-- Content Area -->
        <div class="flex-grow-1 d-flex flex-column" style="min-width: 0;">
            <!-- Navbar ด้านบน -->
            <nav class="navbar navbar-expand navbar-light bg-white border-bottom shadow-sm py-2 px-4 sticky-top">
                <div class="container-fluid px-0">
                    <span class="navbar-brand fw-bold text-dark fs-6 mb-0 d-none d-sm-inline">
                        <i class="bi bi-gear-wide-connected text-primary me-2"></i>ระบบการจัดการระดับผู้บริหาร (Admin Panel)
                    </span>
                    <div class="ms-auto d-flex align-items-center gap-3">
                        <span class="badge bg-warning bg-opacity-20 text-dark border border-warning px-3 py-1 rounded-pill small">
                            <i class="bi bi-person-badge-fill me-1"></i> ผู้ดูแลระบบ (Admin)
                        </span>
                        <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                            <i class="bi bi-box-arrow-right me-1"></i> ออกจากระบบ
                        </a>
                    </div>
                </div>
            </nav>

            <!-- พื้นที่แสดงเนื้อหาหลัก -->
            <div class="p-3 p-md-4 p-xl-5 flex-grow-1">
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-4 mb-4" role="alert">
                        <i class="bi bi-shield-exclamation me-2 fs-5"></i> @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-4 mb-4" role="alert">
                        <i class="bi bi-check-circle-fill me-2 fs-5 text-success"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @RenderBody()
            </div>

            <footer class="py-3 px-4 border-top bg-white text-muted small text-center mt-auto">
                &copy; @DateTime.Now.Year Easy Stay Hotel & Resort - Administration Console
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>

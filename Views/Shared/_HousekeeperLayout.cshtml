@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var userFullName = HttpContextAccessor.HttpContext?.Session.GetString("FullName") ?? "พนักงานแม่บ้าน";
    var userRole = HttpContextAccessor.HttpContext?.Session.GetString("Role") ?? "Housekeeper";
    var currentBranch = HttpContextAccessor.HttpContext?.Session.GetString("Branch") ?? "Bangkok";
}
<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - แดชบอร์ดแม่บ้าน Easy Stay Hotel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Kanit', sans-serif;
            background-color: #f1f5f9;
        }
        .navbar-hk {
            background: linear-gradient(135deg, #0f172a 0%, #0d9488 100%);
        }
        .hk-badge {
            background-color: #14b8a6;
            color: #ffffff;
        }
    </style>
</head>

<body>
    <!-- แถบเมนูด้านบน (Navbar) สำหรับแม่บ้าน -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-hk shadow-sm py-3 sticky-top">
        <div class="container-fluid px-3 px-md-4">
            <a class="navbar-brand fw-bold text-white d-flex align-items-center gap-2" asp-controller="Housekeeper" asp-action="Dashboard">
                <div class="bg-white bg-opacity-20 rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                    <i class="bi bi-stars fs-4 text-warning"></i>
                </div>
                <div>
                    <div class="fs-5 lh-1">Easy Stay Hotel</div>
                    <small class="text-white-50" style="font-size: 0.72rem; letter-spacing: 1px;">HOUSEKEEPING CONSOLE</small>
                </div>
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#hkNav" aria-controls="hkNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="hkNav">
                <ul class="navbar-nav me-auto align-items-lg-center mt-3 mt-lg-0">
                    <li class="nav-item">
                        <a class="nav-link active fw-bold text-white px-3" asp-controller="Housekeeper" asp-action="Dashboard">
                            <i class="bi bi-card-checklist me-1"></i> แดชบอร์ดงานทำความสะอาด (Housekeeping)
                        </a>
                    </li>
                    @if (userRole == "Admin" || userRole == "SuperAdmin")
                    {
                        <li class="nav-item">
                            <a class="nav-link text-warning px-3" asp-controller="Admin" asp-action="Dashboard">
                                <i class="bi bi-speedometer2 me-1"></i> ระบบแอดมิน
                            </a>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link text-white-50 px-3" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house me-1"></i> หน้าแรกเว็บไซต์
                        </a>
                    </li>
                </ul>

                <div class="d-flex flex-wrap align-items-center gap-3 mt-3 mt-lg-0">
                    <!-- Dropdown สลับสาขา -->
                    <div class="dropdown">
                        <button class="btn btn-dark bg-opacity-50 border-0 rounded-pill px-3 py-1 text-white dropdown-toggle small d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-geo-alt-fill text-warning"></i>
                            <span>@(currentBranch == "Phuket" ? "สาขา ภูเก็ต" : currentBranch == "Chonburi" ? "สาขา ชลบุรี (พัทยา)" : "สาขา กรุงเทพฯ")</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3">
                            <li><h6 class="dropdown-header">เลือกสาขาโรงแรม</h6></li>
                            <li><a class="dropdown-item py-2 small" asp-controller="Housekeeper" asp-action="Dashboard" asp-route-branch="Bangkok">สาขากรุงเทพฯ (Bangkok)</a></li>
                            <li><a class="dropdown-item py-2 small" asp-controller="Housekeeper" asp-action="Dashboard" asp-route-branch="Chonburi">สาขาชลบุรี (Chonburi - พัทยา)</a></li>
                            <li><a class="dropdown-item py-2 small" asp-controller="Housekeeper" asp-action="Dashboard" asp-route-branch="Phuket">สาขาภูเก็ต (Phuket)</a></li>
                        </ul>
                    </div>

                    <!-- ข้อมูลผู้ใช้งาน -->
                    <div class="text-white text-end d-none d-sm-block">
                        <div class="fw-bold small">คุณ @userFullName</div>
                        <span class="badge hk-badge rounded-pill" style="font-size: 0.7rem;">@userRole</span>
                    </div>

                    <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-light btn-sm rounded-pill px-3">
                        <i class="bi bi-box-arrow-right me-1"></i> ออกจากระบบ
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- คอนเทนต์หลัก -->
    <main role="main">
        @RenderBody()
    </main>

    <footer class="text-center py-4 text-muted small border-top bg-white mt-5">
        &copy; @DateTime.Now.Year Easy Stay Hotel & Resort - ระบบจัดการงานแม่บ้าน (Housekeeping Operations Console)
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

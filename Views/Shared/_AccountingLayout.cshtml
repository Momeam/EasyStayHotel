@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var userFullName = HttpContextAccessor.HttpContext?.Session.GetString("FullName") ?? "พนักงานบัญชี";
    var userRole = HttpContextAccessor.HttpContext?.Session.GetString("Role") ?? "Accounting";
}
<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ระบบบัญชี Easy Stay</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>

<body class="bg-light" style="font-family: 'Kanit', sans-serif;">
    <!-- แถบเมนูด้านบน (Navbar) สำหรับบัญชี -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm py-3">
        <div class="container-fluid px-4">
            <a class="navbar-brand fw-bold text-warning d-flex align-items-center gap-2" asp-controller="Accounting" asp-action="RevenueReport">
                <i class="bi bi-calculator-fill fs-4 text-warning"></i>
                <span>Easy Stay | Accounting Console</span>
            </a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link active fw-bold text-white" asp-controller="Accounting" asp-action="RevenueReport">
                            <i class="bi bi-graph-up-arrow me-1"></i> สรุปรายได้และ Feedback
                        </a>
                    </li>
                    @if (userRole == "Admin" || userRole == "SuperAdmin")
                    {
                        <li class="nav-item">
                            <a class="nav-link text-warning" asp-controller="Admin" asp-action="Dashboard">
                                <i class="bi bi-speedometer2 me-1"></i> ระบบแอดมิน
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-info" asp-controller="Staff" asp-action="DailyOverview">
                                <i class="bi bi-briefcase me-1"></i> ระบบพนักงาน
                            </a>
                        </li>
                    }
                </ul>
                <div class="d-flex align-items-center gap-3">
                    <span class="text-white-50 small">
                        <i class="bi bi-person-circle text-warning me-1"></i>คุณ @userFullName (@userRole)
                    </span>
                    <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                        <i class="bi bi-box-arrow-right me-1"></i> ออกจากระบบ
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- พื้นที่แสดงเนื้อหาหลัก -->
    <div class="container-fluid px-4 mt-4">
        @RenderBody()
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>

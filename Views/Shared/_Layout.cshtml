@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var userId = HttpContextAccessor.HttpContext?.Session.GetInt32("UserId");
    var userFullName = HttpContextAccessor.HttpContext?.Session.GetString("FullName");
    var userRole = HttpContextAccessor.HttpContext?.Session.GetString("Role");
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Easy Stay Hotel</title>
    <link rel="icon" type="image/png" href="~/images/logo.png" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EasyStayHotel.styles.css" asp-append-version="true" />
    <style>
        body {
            font-family: 'Kanit', sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        .navbar-custom {
            background: rgba(255, 255, 255, 0.96);
            backdrop-filter: blur(10px);
            box-shadow: 0 2px 15px rgba(0, 0, 0, 0.05);
        }
        .nav-link-custom {
            color: #475569 !important;
            font-weight: 500;
            font-size: 0.94rem;
            padding: 0.45rem 0.8rem !important;
            border-radius: 8px;
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            transition: all 0.2s ease;
        }
        .nav-link-custom:hover, .nav-link-custom.active {
            color: #0d6efd !important;
            background-color: rgba(13, 110, 253, 0.08);
        }
        .footer-custom {
            background-color: #0f172a;
            color: #94a3b8;
            margin-top: auto;
        }
    </style>
</head>
<body>
    <header class="sticky-top" style="z-index: 1045;">
        <nav class="navbar navbar-expand-lg navbar-light navbar-custom py-2">
            <div class="container-fluid px-3 px-lg-4 px-xxl-5">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-primary fs-5 py-0 me-2 text-nowrap" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-logo-box border border-light shadow-xs">
                        <img src="~/images/logo.png" alt="Easy Stay Hotel" />
                    </span>
                    <span>Easy Stay <span class="fw-light text-dark fs-6 d-none d-xl-inline">Hotel & Resort</span></span>
                </a>
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="mainNavbar">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-1 flex-lg-nowrap">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom @(currentController == "Home" && currentAction == "Index" ? "active" : "")"
                               asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> หน้าแรก
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" href="@Url.Action("Index", "Home")#room-previews">
                                <i class="bi bi-door-open me-1"></i> พรีวิวห้องพัก
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" href="@Url.Action("Index", "Home")#promotions">
                                <i class="bi bi-tags me-1"></i> โปรโมชั่น
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom @(currentController == "Booking" && currentAction == "MyBookings" ? "active" : "")"
                               asp-controller="Booking" asp-action="MyBookings">
                                <i class="bi bi-journal-check me-1"></i> ตรวจสอบการจอง
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex flex-wrap flex-lg-nowrap align-items-center gap-2 mt-2 mt-lg-0">
                        <!-- ปุ่มเปลี่ยนภาษา (ไทย / English / 中文) สำหรับลูกค้าต่างชาติ -->
                        <div class="dropdown notranslate" translate="no">
                            <button class="btn btn-light border rounded-pill px-3 py-1 dropdown-toggle d-flex align-items-center gap-2 lang-switcher-btn shadow-xs text-nowrap"
                                    type="button" id="langDropdownBtn" data-bs-toggle="dropdown" aria-expanded="false" title="Change Language / เปลี่ยนภาษา / 切换语言" style="height: 38px;">
                                <i class="bi bi-globe2 text-primary"></i>
                                <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-2 py-1 fw-bold" id="currentLangBadge">TH</span>
                                <span class="small fw-medium d-none d-xl-inline text-dark" id="currentLangLabel">ไทย</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-lg-end shadow border-0 rounded-4 mt-2 py-2" aria-labelledby="langDropdownBtn" style="min-width: 190px;">
                                <li class="dropdown-header small text-muted fw-bold px-3 py-1">
                                    <i class="bi bi-translate me-1 text-primary"></i> Language / ภาษา / 语言
                                </li>
                                <li>
                                    <button type="button" class="dropdown-item d-flex align-items-center justify-content-between py-2 px-3 lang-select-item" data-lang="th">
                                        <span class="d-flex align-items-center gap-2">
                                            <span class="badge bg-light text-dark border fw-bold" style="width: 32px;">TH</span>
                                            <span class="small fw-medium">ภาษาไทย (Thai)</span>
                                        </span>
                                        <i class="bi bi-check2 text-primary fw-bold lang-check-icon" data-check-lang="th"></i>
                                    </button>
                                </li>
                                <li>
                                    <button type="button" class="dropdown-item d-flex align-items-center justify-content-between py-2 px-3 lang-select-item" data-lang="en">
                                        <span class="d-flex align-items-center gap-2">
                                            <span class="badge bg-light text-dark border fw-bold" style="width: 32px;">EN</span>
                                            <span class="small fw-medium">English</span>
                                        </span>
                                        <i class="bi bi-check2 text-primary fw-bold lang-check-icon d-none" data-check-lang="en"></i>
                                    </button>
                                </li>
                                <li>
                                    <button type="button" class="dropdown-item d-flex align-items-center justify-content-between py-2 px-3 lang-select-item" data-lang="zh">
                                        <span class="d-flex align-items-center gap-2">
                                            <span class="badge bg-light text-dark border fw-bold" style="width: 32px;">中文</span>
                                            <span class="small fw-medium">中文 (简体)</span>
                                        </span>
                                        <i class="bi bi-check2 text-primary fw-bold lang-check-icon d-none" data-check-lang="zh"></i>
                                    </button>
                                </li>
                            </ul>
                        </div>

                        @if (userId != null)
                        {
                            @if (userRole == "SuperAdmin" || userRole == "Admin")
                            {
                                <div class="btn-group">
                                    <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-warning btn-sm fw-bold rounded-start-pill px-3">
                                        <i class="bi bi-speedometer2 me-1"></i> แอดมิน
                                    </a>
                                    <a asp-controller="Staff" asp-action="BookingList" class="btn btn-dark btn-sm text-info fw-bold rounded-end-pill px-3" title="เข้าสู่ระบบพนักงาน">
                                        <i class="bi bi-briefcase me-1"></i> พนักงาน
                                    </a>
                                </div>
                            }
                            else if (userRole == "Staff")
                            {
                                <a asp-controller="Staff" asp-action="BookingList" class="btn btn-info btn-sm text-white fw-bold rounded-pill px-3">
                                    <i class="bi bi-briefcase me-1"></i> ระบบพนักงาน
                                </a>
                            }
                            else if (userRole == "Accounting")
                            {
                                <a asp-controller="Accounting" asp-action="RevenueReport" class="btn btn-secondary btn-sm fw-bold rounded-pill px-3">
                                    <i class="bi bi-calculator me-1"></i> ระบบบัญชี
                                </a>
                            }
                            else if (userRole == "Housekeeper" || userRole == "Maid")
                            {
                                <a asp-controller="Housekeeper" asp-action="Dashboard" class="btn btn-sm text-white fw-bold rounded-pill px-3 shadow-sm" style="background-color: #0d9488;">
                                    <i class="bi bi-stars me-1"></i> แดชบอร์ดแม่บ้าน
                                </a>
                            }

                            <div class="dropdown">
                                <button class="btn btn-light border rounded-pill px-3 py-1 dropdown-toggle d-flex align-items-center gap-2 text-nowrap" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="height: 38px;">
                                    <i class="bi bi-person-circle text-primary fs-5"></i>
                                    <span class="fw-medium small">คุณ @userFullName</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-lg-end shadow border-0 rounded-3 mt-2">
                                    <li class="px-3 py-2 border-bottom">
                                        <div class="fw-bold small text-dark">@userFullName</div>
                                        <div class="text-muted" style="font-size: 0.75rem;">สถานะ: @(userRole ?? "Customer")</div>
                                    </li>
                                    @if (userRole == "SuperAdmin" || userRole == "Admin")
                                    {
                                        <li>
                                            <a class="dropdown-item py-2 small fw-bold text-warning" asp-controller="Admin" asp-action="Dashboard">
                                                <i class="bi bi-speedometer2 me-2"></i> ระบบแอดมิน (Admin Console)
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2 small fw-medium text-info" asp-controller="Staff" asp-action="BookingList">
                                                <i class="bi bi-briefcase me-2"></i> ระบบพนักงาน (Staff Console)
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2 small fw-medium text-warning" asp-controller="Accounting" asp-action="RevenueReport">
                                                <i class="bi bi-calculator me-2"></i> ระบบบัญชี (Accounting Console)
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2 small fw-medium" style="color: #0d9488;" asp-controller="Housekeeper" asp-action="Dashboard">
                                                <i class="bi bi-stars me-2"></i> แดชบอร์ดแม่บ้าน (Housekeeping)
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider my-1"></li>
                                    }
                                    else if (userRole == "Staff")
                                    {
                                        <li>
                                            <a class="dropdown-item py-2 small fw-bold text-info" asp-controller="Staff" asp-action="BookingList">
                                                <i class="bi bi-briefcase me-2"></i> ระบบพนักงาน (Staff Console)
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider my-1"></li>
                                    }
                                    else if (userRole == "Accounting")
                                    {
                                        <li>
                                            <a class="dropdown-item py-2 small fw-bold text-warning" asp-controller="Accounting" asp-action="RevenueReport">
                                                <i class="bi bi-calculator me-2"></i> ระบบบัญชี (Accounting Console)
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider my-1"></li>
                                    }
                                    else if (userRole == "Housekeeper" || userRole == "Maid")
                                    {
                                        <li>
                                            <a class="dropdown-item py-2 small fw-bold" style="color: #0d9488;" asp-controller="Housekeeper" asp-action="Dashboard">
                                                <i class="bi bi-stars me-2"></i> แดชบอร์ดแม่บ้าน (Housekeeping)
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider my-1"></li>
                                    }
                                    <li>
                                        <a class="dropdown-item py-2 small" asp-controller="Account" asp-action="Profile">
                                            <i class="bi bi-person-gear me-2 text-primary"></i> ข้อมูลส่วนตัว / โปรไฟล์
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 small" asp-controller="Booking" asp-action="MyBookings">
                                            <i class="bi bi-calendar2-check me-2 text-primary"></i> ประวัติการจองของฉัน
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li>
                                        <a class="dropdown-item py-2 small text-danger fw-medium" asp-controller="Account" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right me-2"></i> ออกจากระบบ
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary rounded-pill px-3 py-1 fw-medium text-nowrap d-inline-flex align-items-center" style="height: 38px;">
                                <i class="bi bi-box-arrow-in-right me-1"></i> เข้าสู่ระบบ
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-primary rounded-pill px-3 py-1 fw-medium shadow-sm text-nowrap d-inline-flex align-items-center" style="height: 38px;">
                                <i class="bi bi-person-plus me-1"></i> สมัครสมาชิก
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="container pt-3">
                <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3 mb-0" role="alert">
                    <i class="bi bi-shield-exclamation me-2 fs-5"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="container pt-3">
                <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3 mb-0" role="alert">
                    <i class="bi bi-check-circle-fill me-2 fs-5 text-success"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="footer-custom pt-5 pb-4 mt-5">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-md-4">
                    <div class="d-flex align-items-center gap-2 text-white fw-bold fs-5 mb-3">
                        <span class="brand-logo-box shadow-sm">
                            <img src="~/images/logo.png" alt="Easy Stay Hotel" />
                        </span>
                        <span>Easy Stay Hotel</span>
                    </div>
                    <p class="small mb-3">
                        เครือโรงแรมและรีสอร์ทชั้นนำในประเทศไทย มอบประสบการณ์การพักผ่อนที่เหนือระดับ ในทำเลศักยภาพทั้งกรุงเทพมหานคร ชลบุรี (พัทยา) และภูเก็ต
                    </p>
                </div>
                <div class="col-md-4">
                    <h6 class="text-white fw-bold mb-3">สาขาที่ให้บริการ (Our Branches)</h6>
                    <ul class="list-unstyled small mb-0">
                        <li class="mb-2"><i class="bi bi-geo-alt-fill text-primary me-2"></i> สาขากรุงเทพมหานคร (Bangkok City Center)</li>
                        <li class="mb-2"><i class="bi bi-geo-alt-fill text-primary me-2"></i> สาขาชลบุรี - พัทยา (Pattaya Beachfront)</li>
                        <li class="mb-2"><i class="bi bi-geo-alt-fill text-primary me-2"></i> สาขาภูเก็ต (Phuket Andaman Resort)</li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="text-white fw-bold mb-3">เมนูลัด & ติดต่อเรา</h6>
                    <ul class="list-unstyled small mb-0">
                        <li class="mb-2"><a href="@Url.Action("Index", "Home")#room-previews" class="text-decoration-none text-secondary">ดูพรีวิวห้องพักทั้งหมด</a></li>
                        <li class="mb-2"><a asp-controller="Booking" asp-action="MyBookings" class="text-decoration-none text-secondary">ตรวจสอบสถานะการจอง</a></li>
                        <li class="mb-2"><i class="bi bi-telephone-fill text-primary me-2"></i> โทร: 02-123-4567 (ตลอด 24 ชม.)</li>
                        <li><i class="bi bi-envelope-fill text-primary me-2"></i> อีเมล: contact@easystayhotel.com</li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary opacity-25" />
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center small">
                <div>&copy; @DateTime.Now.Year Easy Stay Hotel (CSI 402 Project). All rights reserved.</div>
                <div class="mt-2 mt-sm-0">
                    <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-secondary text-decoration-none">นโยบายความเป็นส่วนตัว</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

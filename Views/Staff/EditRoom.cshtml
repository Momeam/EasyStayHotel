@model EasyStayHotel.Models.Room
@{
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
    ViewData["Title"] = "เปลี่ยนสถานะห้องพัก";
}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 mt-4">
            <div class="card-header bg-warning text-dark">
                <h5 class="card-title m-0">เปลี่ยนสถานะห้องพัก (หมายเลข @Model.RoomNo)</h5>
            </div>
            <div class="card-body p-4">
                <form asp-controller="Staff" asp-action="EditRoom" method="post">
                    <input type="hidden" asp-for="RoomId" />
                    <input type="hidden" asp-for="RoomNo" />
                    <input type="hidden" asp-for="RoomTypeId" />
                    <div class="mb-4">
                        <label asp-for="Status" class="form-lable fw-bold">เลือกสถานะใหม่:</label>
                        <select asp-for="Status" class="form-select border-primary">
                            <option value="Available">ว่างพร้อมใช้งาน</option>
                            <option value="Occupied">มีแขกเข้าพักอยู่</option>
                            <option value="Cleaning">รอทำความสะอาด</option>
                            <option value="Maintenance">ซ่อมบำรุง</option>
                        </select>
                    </div>
                    <div class="d-flex justify-content-end">
                        <a asp-controller="Staff" asp-action="Index" class="btn btn-secondary me-2">ยกเลิก</a>
                        <button type="submit" class="btn btn-primary">บันทึกการเปลี่ยนแปลง</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@model EasyStayHotel.Models.Booking
@{
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
    ViewData["Title"] = "ใบเสร็จรับเงิน (Receipt)";
    
    // ดึงข้อมูล Payment จาก ViewBag ที่ส่งมาจาก Controller
    var payment = ViewBag.Payment as EasyStayHotel.Models.Payment;
}

<!-- แถบควบคุม (แสดงเฉพาะบนจอ ซ่อนตอนพิมพ์) -->
<div class="card border-0 shadow-sm rounded-4 bg-white p-3 p-md-4 mb-4 no-print">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <h4 class="fw-bold m-0 text-success"><i class="bi bi-file-earmark-check-fill me-2"></i>เอกสารการจองและหลักฐานการเข้าพัก</h4>
            <small class="text-muted">รหัสการจอง: <strong class="font-monospace text-primary">@Model.BookingRef</strong> • สำหรับพนักงานพิมพ์เก็บเป็นหลักฐานหรือมอบให้ผู้เข้าพัก</small>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="DailyOverview" class="btn btn-outline-primary fw-bold rounded-pill px-3 text-nowrap"><i class="bi bi-calendar2-day me-1"></i> ภาพรวมรายวัน</a>
            <a asp-action="BookingList" class="btn btn-outline-secondary fw-bold rounded-pill px-3 text-nowrap"><i class="bi bi-list-check me-1"></i> รายชื่อผู้เข้าพัก</a>
            <button onclick="window.print()" class="btn btn-primary fw-bold rounded-pill px-4 shadow-sm text-nowrap" style="background-color: #2b6cb0; border: none;">
                <i class="bi bi-printer-fill me-1"></i> พิมพ์ / ดาวน์โหลดเอกสาร (Print / PDF)
            </button>
        </div>
    </div>
</div>

<!-- พื้นที่ใบเสร็จ (จำลองหน้ากระดาษ A4) -->
<div class="container-fluid p-0 pb-5">
    <div class="receipt-paper bg-white mx-auto p-4 p-md-5 shadow-sm border rounded-4" style="max-width: 820px;">
        
        <!-- ส่วนหัวใบเสร็จ -->
        <div class="row mb-4 align-items-center">
            <div class="col-sm-6">
                <div class="d-flex align-items-center">
                    <div class="bg-dark text-white rounded d-flex align-items-center justify-content-center me-3" style="width: 60px; height: 60px;">
                        <i class="bi bi-buildings-fill fs-2"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold m-0" style="color: #1a202c;">Easy Stay Hotel</h3>
                        <p class="text-muted small m-0">123 ถนนสุขุมวิท กรุงเทพมหานคร 10110</p>
                        <p class="text-muted small m-0">โทร: 02-123-4567 | TAX ID: 0105550000000</p>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 text-sm-end mt-3 mt-sm-0">
                <h3 class="fw-bold text-uppercase m-0" style="color: #2b6cb0;">Booking Voucher & Receipt</h3>
                <h6 class="text-muted fw-bold">ใบยืนยันการจองและหลักฐานการเข้าพัก / ใบเสร็จรับเงิน</h6>
            </div>
        </div>

        <hr class="opacity-50 border-dark mb-4" />

        <!-- ข้อมูลลูกค้าและการจอง -->
        <div class="row mb-4">
            <div class="col-sm-6">
                <h6 class="text-muted small fw-bold mb-1">ข้อมูลลูกค้า (Guest Info):</h6>
                <p class="fw-bold fs-5 mb-1">@(Model.GuestName ?? Model.User?.FullName ?? "-")</p>
                <div class="small text-muted mb-1"><i class="bi bi-telephone me-1"></i> เบอร์โทรศัพท์: @(Model.User?.Phone ?? "-")</div>
                <div class="small text-muted mb-1"><i class="bi bi-envelope me-1"></i> อีเมล: @(Model.User?.Email ?? "-")</div>
                <p class="small text-muted mb-0">ผู้ออกเอกสาร: พนักงานต้อนรับ (Staff Terminal)</p>
            </div>
            <div class="col-sm-6">
                <table class="table table-borderless table-sm small mb-0">
                    <tbody>
                        <tr>
                            <td class="text-muted fw-bold text-sm-end" width="50%">รหัสอ้างอิง (Booking No):</td>
                            <td class="fw-bold text-end">@Model.BookingRef</td>
                        </tr>
                        <tr>
                            <td class="text-muted fw-bold text-sm-end">วันที่ออกใบเสร็จ (Date):</td>
                            <td class="text-end">@DateTime.Now.ToString("dd MMM yyyy HH:mm")</td>
                        </tr>
                        <tr>
                            <td class="text-muted fw-bold text-sm-end">เช็คอิน (Check-In):</td>
                            <td class="text-end">@Model.CheckInDate.ToString("dd/MM/yyyy")</td>
                        </tr>
                        <tr>
                            <td class="text-muted fw-bold text-sm-end">เช็คเอาท์ (Check-Out):</td>
                            <td class="text-end">@Model.CheckOutDate.ToString("dd/MM/yyyy")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ตารางรายการ -->
        <table class="table table-bordered mb-4">
            <thead class="table-light text-center small fw-bold">
                <tr>
                    <th width="5%">#</th>
                    <th width="55%" class="text-start">รายการ (Description)</th>
                    <th width="20%">จำนวนคืน (Nights)</th>
                    <th width="20%" class="text-end">จำนวนเงิน (Amount)</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int nights = Model.CheckOutDate.DayNumber - Model.CheckInDate.DayNumber;
                    if(nights <= 0) nights = 1; 
                }
                <tr>
                    <td class="text-center">1</td>
                    <td>
                        @if (Model.BookingStatus == "CheckIn" || Model.BookingStatus == "CheckedIn" || Model.BookingStatus == "Completed")
                        {
                            <span class="fw-bold">ห้องพักหมายเลข @(Model.Room?.RoomNo ?? "-")</span><br />
                        }
                        else
                        {
                            <span class="fw-bold text-muted"><i class="bi bi-clock me-1"></i>จัดสรรหมายเลขห้อง ณ วันเช็คอิน</span><br />
                        }
                        <small class="text-muted">ประเภท: @(Model.Room?.RoomType?.TypeName ?? "-")</small>
                    </td>
                    <td class="text-center">@nights</td>
                    <td class="text-end fw-bold">฿@Model.TotalPrice.ToString("N2")</td>
                </tr>
            </tbody>
        </table>

        <!-- สรุปยอดเงินและสถานะ -->
        <div class="row g-3">
            <div class="col-sm-6">
                <div class="p-3 bg-light rounded-3 border">
                    <p class="small fw-bold text-muted mb-2">สถานะการชำระเงิน (Payment Status):</p>
                    @if (payment != null && payment.PaymentStatus == "Paid")
                    {
                        <h5 class="text-success fw-bold m-0"><i class="bi bi-check-circle-fill me-1"></i> ชำระเงินเรียบร้อย (Paid)</h5>
                        
                        string displayMethod = "เงินสด (Cash)";
                        if (payment.PaymentMethod == "PromptPay") { displayMethod = "พร้อมเพย์ (PromptPay)"; }
                        else if (payment.PaymentMethod == "CreditCard") { displayMethod = "บัตรเครดิต (Credit Card)"; }
                        
                        <p class="small text-muted m-0 mt-1">
                            ช่องทาง: <strong>@displayMethod</strong>
                            @(payment.TransferDate != null ? $" • วันที่: {payment.TransferDate.Value.ToString("dd/MM/yyyy HH:mm น.")}" : "")
                        </p>

                        @if (!string.IsNullOrEmpty(payment.SlipImageUrl))
                        {
                            <div class="mt-2 no-print">
                                <a href="@payment.SlipImageUrl" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    <i class="bi bi-image me-1"></i> ดูสลิปหลักฐานการโอนเงิน
                                </a>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="badge bg-warning text-dark fs-6 px-3 py-2 rounded-pill">
                                <i class="bi bi-hourglass-split me-1"></i> รอดำเนินการ (Pending)
                            </span>
                        </div>
                        <p class="small text-muted m-0">ยังไม่มีการยืนยันยอดเงินเข้าระบบ</p>

                        <!-- หากลูกค้าโอนผ่าน PromptPay และแนบสลิปมา -->
                        @if (!string.IsNullOrEmpty(payment?.SlipImageUrl))
                        {
                            <div class="mt-3 p-2 bg-white rounded-3 border no-print">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div class="small fw-bold text-primary">
                                        <i class="bi bi-receipt text-primary me-1"></i> มีสลิปหลักฐานโอนเงิน
                                    </div>
                                    <a href="@payment.SlipImageUrl" target="_blank" class="btn btn-sm btn-primary rounded-pill px-3">
                                        <i class="bi bi-eye me-1"></i> เปิดดูรูปสลิป
                                    </a>
                                </div>
                            </div>
                        }

                        <!-- กล่องควบคุมสำหรับพนักงานในการกดยืนยันรับเงิน (ซ่อนตอนพิมพ์) -->
                        <div class="mt-3 p-3 bg-white border border-warning rounded-3 no-print shadow-sm">
                            <h6 class="fw-bold text-dark mb-1 small">
                                <i class="bi bi-shield-check text-success me-1"></i> แผงควบคุมพนักงาน: ยืนยันการรับเงิน
                            </h6>
                            <p class="text-muted small mb-2" style="font-size: 0.78rem;">
                                เมื่อตรวจสอบสลิปโอนเงินถูกต้อง หรือรับเงินสดจากแขกเรียบร้อยแล้ว ให้เลือกช่องทางและกดยืนยัน
                            </p>
                            <form asp-action="ConfirmPayment" method="post" class="row g-2 align-items-center">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="bookingId" value="@Model.BookingId" />
                                <div class="col-sm-7">
                                    <select name="paymentMethod" class="form-select form-select-sm border-primary">
                                        <option value="Cash">ได้รับเป็นเงินสด (Cash)</option>
                                        <option value="PromptPay" selected="@(payment?.PaymentMethod == "PromptPay")">ตรวจสอบสลิปพร้อมเพย์แล้ว (PromptPay)</option>
                                        <option value="CreditCard">รูดบัตรเครดิต/เดบิตแล้ว (Card)</option>
                                    </select>
                                </div>
                                <div class="col-sm-5">
                                    <button type="submit" class="btn btn-success btn-sm w-100 fw-bold rounded-pill shadow-sm" onclick="return confirm('ยืนยันการรับชำระเงินยอด ฿@Model.TotalPrice.ToString("N2")?');">
                                        <i class="bi bi-check-circle-fill me-1"></i> ยืนยันรับชำระเงิน
                                    </button>
                                </div>
                            </form>
                        </div>
                    }
                </div>
            </div>
            <div class="col-sm-6">
                <table class="table table-borderless table-sm mb-0">
                    <tbody>
                        <tr>
                            <td class="text-end fw-bold text-muted">ยอดรวมสุทธิ (Net Total):</td>
                            <td class="text-end fw-bold fs-4 text-primary" style="color: #2b6cb0 !important;" width="40%">฿@Model.TotalPrice.ToString("N2")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <hr class="opacity-50 border-dark mt-5 mb-4" />

        <!-- ลายเซ็น -->
        <div class="row text-center mt-5 pb-3">
            <div class="col-6">
                <p class="mb-5">_______________________</p>
                <p class="small text-muted fw-bold mb-0">ลายเซ็นลูกค้า (Guest Signature)</p>
            </div>
            <div class="col-6">
                <p class="mb-5">_______________________</p>
                <p class="small text-muted fw-bold mb-0">พนักงานรับเงิน (Authorized Signature)</p>
            </div>
        </div>
        
    </div>
</div>

<!-- สไตล์ CSS จัดการระบบการพิมพ์ -->
<style>
    /* ตั้งค่าฟอนต์ */
    .receipt-paper {
        font-family: 'Kanit', sans-serif;
    }

    /* 
        print จะทำงานเฉพาะตอนที่เรากดสั่งพิมพ์ (Ctrl+P หรือคำสั่ง window.print())
       เราจะใช้ตรงนี้แหละ ซ่อนเมนู และจัดหน้ากระดาษ!
    */
    @@media print {
        /* บังคับพื้นหลังกระดาษเป็นสีขาว */
        body { background-color: white !important; }
        
        /* ซ่อนคลาส .no-print (แถบปุ่มกด) และ .sidebar (เมนูด้านซ้าย) */
        .no-print, .sidebar { display: none !important; }
        
        /* ขยายพื้นที่คอนเทนต์หลักให้เต็มหน้ากระดาษ */
        .flex-grow-1 { width: 100% !important; }
        
        /* เอาเงาและกรอบของการ์ดกระดาษออกเวลาพิมพ์ */
        .receipt-paper {
            box-shadow: none !important;
            border: none !important;
            padding: 0 !important;
            max-width: 100% !important;
        }

        /* ตั้งค่าระยะขอบกระดาษจริง */
        @@page {
            margin: 1.5cm;
        }
    }
</style>
@{
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
    ViewData["Title"] = "ภาพรวมรายวัน (Daily Overview)";

    var arrivals = ViewBag.ArrivalsToday as List<EasyStayHotel.Models.Booking> ?? new List<EasyStayHotel.Models.Booking>();
    var departures = ViewBag.DeparturesToday as List<EasyStayHotel.Models.Booking> ?? new List<EasyStayHotel.Models.Booking>();
    var inHouse = ViewBag.InHouseBookings as List<EasyStayHotel.Models.Booking> ?? new List<EasyStayHotel.Models.Booking>();
    DateOnly targetDate = ViewBag.TargetDate != null ? (DateOnly)ViewBag.TargetDate : DateOnly.FromDateTime(DateTime.Today);
    bool isToday = ViewBag.IsToday != null && (bool)ViewBag.IsToday;
}

<div class="container-fluid py-4 mb-5">
    <!-- ส่วนหัวและแถบเลือกวันที่ / สาขา -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-3 py-1 rounded-pill">
                    <i class="bi bi-geo-alt-fill me-1"></i> สาขา@ViewBag.CurrentBranchTh
                </span>
                @if (isToday)
                {
                    <span class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-1 rounded-pill">
                        <i class="bi bi-clock-history me-1"></i> ข้อมูลวันนี้ (Today)
                    </span>
                }
            </div>
            <h3 class="fw-bold mt-2 mb-1 text-dark">ภาพรวมงานประจำวัน (Daily Operations)</h3>
            <p class="text-muted small mb-0">ติดตามสถิติการเช็คอิน เช็คเอาท์ แขกพักในโรงแรม และสถานะห้องพักประจำวันที่ @ViewBag.TargetDateTh</p>
        </div>

        <!-- ตัวเลือกวันที่ -->
        <form method="get" asp-action="DailyOverview" class="d-flex align-items-center gap-2 bg-white p-2 rounded-3 shadow-sm border">
            <span class="text-muted small fw-bold ps-2"><i class="bi bi-calendar-event text-primary"></i> วันที่:</span>
            <input type="date" name="date" class="form-control form-control-sm border-0 bg-light" value="@ViewBag.TargetDateStr" onchange="this.form.submit()" />
            <a asp-action="DailyOverview" asp-route-date="@DateTime.Today.ToString("yyyy-MM-dd")" class="btn btn-sm btn-outline-primary rounded-pill px-3 @(isToday ? "active" : "")">วันนี้</a>
        </form>
    </div>

    <!-- 1. การ์ดสถิติภาพรวม 5 ช่อง (Metrics Cards) -->
    <div class="row g-3 mb-4">
        <!-- แขกเช็คอิน -->
        <div class="col-xl-2 col-md-4 col-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-primary border-4 p-3">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-muted small fw-bold">เช็คอินวันนี้</span>
                    <span class="badge bg-primary rounded-circle p-2"><i class="bi bi-box-arrow-in-right"></i></span>
                </div>
                <h2 class="fw-bold text-dark mb-0">@arrivals.Count</h2>
                <small class="text-primary mt-1 d-block"><i class="bi bi-person-fill"></i> แขกจะเข้าพัก</small>
            </div>
        </div>

        <!-- แขกเช็คเอาท์ -->
        <div class="col-xl-2 col-md-4 col-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-danger border-4 p-3">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-muted small fw-bold">เช็คเอาท์วันนี้</span>
                    <span class="badge bg-danger rounded-circle p-2"><i class="bi bi-box-arrow-right"></i></span>
                </div>
                <h2 class="fw-bold text-dark mb-0">@departures.Count</h2>
                <small class="text-danger mt-1 d-block"><i class="bi bi-door-closed-fill"></i> ห้องต้องเคลียร์</small>
            </div>
        </div>

        <!-- กำลังพักอยู่ -->
        <div class="col-xl-2 col-md-4 col-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-success border-4 p-3">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-muted small fw-bold">กำลังพักอยู่</span>
                    <span class="badge bg-success rounded-circle p-2"><i class="bi bi-people-fill"></i></span>
                </div>
                <h2 class="fw-bold text-dark mb-0">@inHouse.Count</h2>
                <small class="text-success mt-1 d-block">In-House Guests</small>
            </div>
        </div>

        <!-- ห้องว่างพร้อมใช้ -->
        <div class="col-xl-2 col-md-4 col-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-info border-4 p-3">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-muted small fw-bold">ห้องว่างพร้อมขาย</span>
                    <span class="badge bg-info text-white rounded-circle p-2"><i class="bi bi-door-open-fill"></i></span>
                </div>
                <h2 class="fw-bold text-info mb-0">@ViewBag.AvailableRooms</h2>
                <small class="text-muted mt-1 d-block">จาก @ViewBag.TotalRooms ห้อง</small>
            </div>
        </div>

        <!-- รอทำความสะอาด -->
        <div class="col-xl-2 col-md-4 col-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-warning border-4 p-3">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-muted small fw-bold">รอแม่บ้านทำความสะอาด</span>
                    <span class="badge bg-warning text-dark rounded-circle p-2"><i class="bi bi-stars"></i></span>
                </div>
                <h2 class="fw-bold text-warning mb-0">@ViewBag.CleaningRooms</h2>
                <small class="text-muted mt-1 d-block">ห้องรอทำความสะอาด</small>
            </div>
        </div>

        <!-- รายรับวันนี้ -->
        <div class="col-xl-2 col-md-4 col-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-dark text-white p-3">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-white-50 small fw-bold">รายรับวันที่เลือก</span>
                    <span class="badge bg-success rounded-circle p-2"><i class="bi bi-cash-stack"></i></span>
                </div>
                <h3 class="fw-bold text-warning mb-0">฿@(((decimal)ViewBag.TotalRevenue).ToString("N0"))</h3>
                <small class="text-white-50 mt-1 d-block">สด ฿@(((decimal)ViewBag.CashRevenue).ToString("N0")) • โอน ฿@(((decimal)ViewBag.PromptPayRevenue).ToString("N0"))</small>
            </div>
        </div>
    </div>

    <!-- 2. แถบปุ่มทางลัดปฏิบัติการด่วน (Quick Actions Bar) -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-primary bg-opacity-10 border border-primary border-opacity-25 p-3">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-primary text-white rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-lightning-charge-fill fs-5"></i>
                </div>
                <div>
                    <h6 class="fw-bold text-primary mb-1">เมนูปฏิบัติการด่วนหน้าเคาน์เตอร์</h6>
                    <small class="text-muted">เช็คอินลูกค้าจองออนไลน์, เปิดห้อง Walk-in, หรือส่งรายงานประจำกะ</small>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="CheckInDesk" class="btn btn-primary fw-bold rounded-pill px-3 shadow-sm">
                    <i class="bi bi-key-fill me-1"></i> เช็คอินการจองออนไลน์
                </a>
                <a asp-action="WalkinBooking" class="btn btn-success fw-bold rounded-pill px-3 shadow-sm">
                    <i class="bi bi-person-plus-fill me-1"></i> เปิดห้อง Walk-in
                </a>
                <a asp-action="Index" class="btn btn-outline-primary fw-medium rounded-pill px-3 bg-white shadow-sm">
                    <i class="bi bi-door-open-fill me-1"></i> ผังห้องพักทั้งหมด
                </a>
                <a asp-action="AccountingFeedback" class="btn btn-warning fw-bold text-dark rounded-pill px-3 shadow-sm">
                    <i class="bi bi-send-check-fill me-1"></i> ส่งรายงานกะไปบัญชี
                </a>
            </div>
        </div>
    </div>

    <!-- 3. ตารางคู่: แขกจะเช็คอินวันนี้ VS แขกจะเช็คเอาท์วันนี้ -->
    <div class="row g-4">
        <!-- ฝั่งซ้าย: แขกจะเช็คอิน (Arrivals) -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white overflow-hidden">
                <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary p-2 rounded-circle"><i class="bi bi-box-arrow-in-right text-white"></i></span>
                        <h6 class="fw-bold m-0 text-dark">รายการเช็คอินวันที่เลือก (@arrivals.Count รายการ)</h6>
                    </div>
                    <a asp-action="CheckInDesk" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                        <i class="bi bi-search me-1"></i> ค้นหาเช็คอิน
                    </a>
                </div>
                <div class="card-body p-0">
                    @if (arrivals.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light small">
                                    <tr>
                                        <th>รหัสการจอง</th>
                                        <th>ชื่อแขก</th>
                                        <th>ห้องที่จอง</th>
                                        <th>สถานะ</th>
                                        <th class="text-end">ดำเนินการ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in arrivals)
                                    {
                                        <tr>
                                            <td>
                                                <span class="fw-bold font-monospace text-primary">@item.BookingRef</span>
                                            </td>
                                            <td>
                                                <div class="fw-bold text-dark">@(item.GuestName ?? item.User?.FullName ?? "ไม่ระบุชื่อ")</div>
                                                <small class="text-muted">@(item.User?.Phone ?? "-")</small>
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark border">
                                                    @(item.Room?.RoomType?.TypeName ?? "Standard")
                                                </span>
                                                <small class="text-muted d-block">ห้อง @(item.Room?.RoomNo ?? "-")</small>
                                            </td>
                                            <td>
                                                @if (item.BookingStatus == "CheckIn" || item.BookingStatus == "CheckedIn")
                                                {
                                                    <span class="badge bg-success rounded-pill px-2 py-1">เข้าพักแล้ว</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark rounded-pill px-2 py-1">รอเช็คอิน</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                @if (item.BookingStatus != "CheckIn" && item.BookingStatus != "CheckedIn")
                                                {
                                                    <a asp-action="CheckInDesk" asp-route-bookingRef="@item.BookingRef" class="btn btn-sm btn-primary rounded-pill px-3 fw-bold">
                                                        <i class="bi bi-key-fill me-1"></i> จัดห้อง & เช็คอิน
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a asp-action="BookingReceipt" asp-route-id="@item.BookingId" class="btn btn-sm btn-outline-secondary rounded-pill px-2">
                                                        <i class="bi bi-receipt"></i> ใบเสร็จ
                                                    </a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-calendar-x fs-1 opacity-25 d-block mb-2"></i>
                            <p class="mb-0 small">ไม่มีรายการเช็คอินในวันที่เลือก</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- ฝั่งขวา: แขกจะเช็คเอาท์ (Departures) -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white overflow-hidden">
                <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-danger p-2 rounded-circle"><i class="bi bi-box-arrow-right text-white"></i></span>
                        <h6 class="fw-bold m-0 text-dark">รายการเช็คเอาท์วันที่เลือก (@departures.Count รายการ)</h6>
                    </div>
                </div>
                <div class="card-body p-0">
                    @if (departures.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light small">
                                    <tr>
                                        <th>ห้อง</th>
                                        <th>ชื่อแขก</th>
                                        <th>รหัสการจอง</th>
                                        <th>ยอดชำระ</th>
                                        <th class="text-end">ดำเนินการ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in departures)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge bg-dark fs-6 rounded-3 px-3 py-1">
                                                    @(item.Room?.RoomNo ?? "-")
                                                </span>
                                            </td>
                                            <td>
                                                <div class="fw-bold text-dark">@(item.GuestName ?? item.User?.FullName ?? "ไม่ระบุ")</div>
                                                <small class="text-muted">@(item.Room?.RoomType?.TypeName)</small>
                                            </td>
                                            <td>
                                                <span class="font-monospace small text-muted">@item.BookingRef</span>
                                            </td>
                                            <td>
                                                <span class="fw-bold text-success">฿@item.TotalPrice.ToString("N0")</span>
                                            </td>
                                            <td class="text-end">
                                                <form asp-action="CheckOutBooking" method="post" class="d-inline" onsubmit="return confirm('ยืนยันการเช็คเอาท์ห้อง @(item.Room?.RoomNo)? ห้องจะถูกส่งต่อให้แม่บ้านทำความสะอาด');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.BookingId" />
                                                    <button type="submit" class="btn btn-sm btn-danger rounded-pill px-3 fw-bold">
                                                        <i class="bi bi-box-arrow-right me-1"></i> เช็คเอาท์
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-check2-circle fs-1 text-success opacity-25 d-block mb-2"></i>
                            <p class="mb-0 small">ไม่มีรายการเช็คเอาท์ที่ค้างอยู่ในวันที่เลือก</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
